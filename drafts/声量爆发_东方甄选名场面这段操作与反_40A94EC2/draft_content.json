    "videos": [
      {
        "id": "03abdf2e-33db-45ea-b3ec-7411b75972db",
        "path": "E:\\代码\\美食街\\live-cutter\\recordings\\21-14-39_东方甄选_p043.mp4",
        "type": "video",
        "duration": 3600000000,
        "width": 1080,
        "height": 1920
      }
    ],
    "texts": [
      {
        "id": "9c4baa2f-761d-4a7b-9aa8-e616d6fa6606",
        "content": "{\"text\": \"不便\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "795e63c5-2da1-4cc6-ba97-78c8e1e87fee",
        "content": "{\"text\": \"然后外边传着的这个发热丝也不便\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3b7fe205-1be5-467a-b815-7e5648e6b50d",
        "content": "{\"text\": \"但是在这个外边人家不直接包那个决想交\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8c23a6dc-ed80-4d47-be66-e644a6004375",
        "content": "{\"text\": \"而是再来一层这个薄薄的一层相交给他套上\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8522e1ef-ba70-4c30-99d1-7520f18cfce9",
        "content": "{\"text\": \"那这层相交的容点是70度上下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6378ce14-9f60-42bb-9a62-85cfce31c1c3",
        "content": "{\"text\": \"各位咱们都有尝试\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "063ac979-8bf5-4336-a44e-924539998e1a",
        "content": "{\"text\": \"70度上下距离引发火灾的温度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c425feb1-f36f-4a2e-8bfa-e35d14c16cab",
        "content": "{\"text\": \"是不是还早着呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ef14dab6-3ad0-4c84-aa9c-665d18f7da64",
        "content": "{\"text\": \"对吧 还差特别多\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8542d3bd-d753-48bd-a4a2-88ca5785f137",
        "content": "{\"text\": \"那么在这层相交外边又传绕了这样的一圈\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "11499927-3590-48bd-9c7a-686c5ef096ae",
        "content": "{\"text\": \"同时那么你想当如果真是到了70度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "247bd87d-2165-4bcf-8dd7-2000c95e17b6",
        "content": "{\"text\": \"这个相交就容调了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f714df15-058f-49c2-b546-8a7fc693c481",
        "content": "{\"text\": \"一容调之后\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1c8da2ee-132f-46df-af2d-85a7b5797d61",
        "content": "{\"text\": \"离白的这个相交丝跟外边的这个相交丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f8e15125-c893-472b-be01-07af5d705259",
        "content": "{\"text\": \"是吧 离白的这个发热丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2cb7042f-2d12-46d8-a9a9-8c56df8053a5",
        "content": "{\"text\": \"跟外边的这个同时是不是接触上了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1c760a8e-3fb2-4c08-b96e-699e1955b050",
        "content": "{\"text\": \"那是不是就引起这个断电保护老朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "001874f7-b6e3-4781-9165-e25f9e2fdf39",
        "content": "{\"text\": \"那你想想这个安心的指数\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bdfe6e36-c7eb-49d6-971d-966c09d38d16",
        "content": "{\"text\": \"是不是叫大大提升了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3f2e7e99-98cb-400e-a218-774d51c58e98",
        "content": "{\"text\": \"是不是这就是咱们的这个品质\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "285c0735-b42b-4cbe-920e-93558e141dcd",
        "content": "{\"text\": \"你看他每一个都多加这么两层料\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "85fffe7a-7920-45f0-a3b6-8b330481f5a8",
        "content": "{\"text\": \"是不是要增加成本\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "45212f20-29cc-4ada-876b-8ef381864774",
        "content": "{\"text\": \"但是咱们还是本着这个品质\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8d8a7f16-69a5-4bc2-a1b1-d9bcb4224293",
        "content": "{\"text\": \"对吧 安全安心这些角度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "03187e3b-c880-4483-8ee0-ef09981a81cd",
        "content": "{\"text\": \"咱们这就是咱们资似若年的大品质\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
