        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "794ca55a-c8cc-4020-97f9-c086d9bc80f8",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a93e356c-6117-4b90-839b-32404d800863",
        "content": "{\"text\": \"然后就没了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bf9c44d2-0e01-4a76-a4ea-2ae61e4f1ebe",
        "content": "{\"text\": \"明天我们就卖其他的品\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fb8cc0df-626a-458e-b872-835685a9d416",
        "content": "{\"text\": \"这我们就会被经了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "71168f23-7465-4f13-9378-5fc814608fb0",
        "content": "{\"text\": \"来给大家看一下\"}",
