        "content": "{\"text\": \"而且的话是行业的这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4a492b49-260b-417d-84a5-4c34705c7251",
        "content": "{\"text\": \"在国标维度的制定者之一\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bf1e1e88-5f23-45e4-8d4d-c8e50f5168c1",
        "content": "{\"text\": \"真的是很硬和的一个大品牌\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ff46304c-f152-4c28-ac7b-5673cfb1afa8",
        "content": "{\"text\": \"所以各位之所以很多人\"}",
        "font_size": 8.0,
