    "texts": [
      {
        "id": "0d2227b6-f31c-418e-9a16-f3af063c4a78",
        "content": "{\"text\": \"发现一路\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "49e26260-7a56-4f74-a889-0ae711ab3145",
        "content": "{\"text\": \"加油\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9e83b253-6647-4fc0-b5b4-103fe26c4148",
        "content": "{\"text\": \"我睡醒来\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0408e192-30ca-427a-a259-0c9d4f6d4bcc",
        "content": "{\"text\": \"里面爱你\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6f04674a-44c8-464e-8777-235050913a42",
        "content": "{\"text\": \"后里头还两条\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9be3e953-3598-4ad4-9244-12428e5d3fc5",
        "content": "{\"text\": \"我们起来温起来\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2de6a49c-1731-46c9-a362-2cb6f8840568",
        "content": "{\"text\": \"好吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "124e87f1-79bc-4a3f-a3d7-3c3084ff1233",
        "content": "{\"text\": \"这一场面把它剩下两条\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ea6e6f8a-8afe-4c75-bfa8-5febe370a0fd",
        "content": "{\"text\": \"给它解决掉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c5a9e238-db26-4de7-9ecb-712f27972bea",
        "content": "{\"text\": \"好的是比赛服\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9edaf7af-f4b9-4d5d-bcad-d95611168cc7",
        "content": "{\"text\": \"就是我们比赛服\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "56b88176-06cc-4127-b961-e0497b1f50e9",
        "content": "{\"text\": \"明天就是随时的时候\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2ea82d12-c75c-49c4-a397-c54f2624aaa4",
        "content": "{\"text\": \"往12斤拔的比赛开始了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a92ae053-2df5-4003-9a0d-1c2f04ee6891",
        "content": "{\"text\": \"我们这里要活躺\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1c75e500-446b-4530-b11c-27677f4dd01d",
        "content": "{\"text\": \"我进了5个人在12条\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8a176893-757d-422f-bd81-87efe6a074dc",
        "content": "{\"text\": \"12斤拔\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d41e6fdc-8555-4f2e-a7d4-58cc3949f10c",
        "content": "{\"text\": \"至少过请进去3个以上的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cf617120-c996-4658-b341-89372e7eaa63",
        "content": "{\"text\": \"不让我的电顿此后\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f9076f52-0d30-4b99-9273-20242cbdcb92",
        "content": "{\"text\": \"前年失落\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "70f7b5f0-7979-42fa-959a-310aaddd632f",
        "content": "{\"text\": \"就是一张骑士观伤性的超级效力服\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
