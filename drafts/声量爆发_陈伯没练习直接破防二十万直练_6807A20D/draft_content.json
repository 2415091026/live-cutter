    "texts": [
      {
        "id": "7fa1fcce-f66c-494c-a547-b88bbf38635e",
        "content": "{\"text\": \"需要解釋關注\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d65f80a0-5985-46b9-a989-42f8cc34bc0a",
        "content": "{\"text\": \"解釋關注中獎給力量評估是吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "69ab77f8-b5db-4241-8bb6-f8306417b14f",
        "content": "{\"text\": \"是吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2ff5f6a5-f552-4238-8b3f-648dbcbd8f64",
        "content": "{\"text\": \"是吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "649e3fbd-6146-4bc6-98c3-6c5450546487",
        "content": "{\"text\": \"解釋關注中獎拿著一台評估是吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bc80db55-a296-4396-a54a-08bd6ca81cc2",
        "content": "{\"text\": \"沒練習關注什麼都沒有啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f0bfc32b-3692-455a-a449-30d8fe669439",
        "content": "{\"text\": \"一定要解釋關注是甚麼\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "daeefb06-547f-47d2-a3ca-91672084dcbe",
        "content": "{\"text\": \"解釋關注是甚麼\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e6831c0e-0d07-4cfa-ba62-0ae939859a3c",
        "content": "{\"text\": \"我們這邊要是拿關注的話\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "98df6edf-c74f-4443-ae43-2a91fe96bddf",
        "content": "{\"text\": \"二十萬直練發來直播盡了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b9595ab5-a1c5-42d2-814b-37d43f8bbdde",
        "content": "{\"text\": \"但是守住的話\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "be18ed90-9371-423b-8ecb-c76bd858f5c7",
        "content": "{\"text\": \"我們是六打吧\"}",
        "font_size": 8.0,
