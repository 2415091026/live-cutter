    "texts": [
      {
        "id": "99677875-cc83-4e58-9614-13fc7bc2e9b8",
        "content": "{\"text\": \"对 越大这外边的话就越没什么天\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e1cccd54-a3a4-4eac-bde0-76b5cd1e72c3",
        "content": "{\"text\": \"好不好 说不过\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "39b22eb6-62a0-441c-b2fd-69799624669e",
        "content": "{\"text\": \"越靠地面越挺越到外面这越不天\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c8ebd1bd-3dab-4401-b07b-d0e485fd03c5",
        "content": "{\"text\": \"蛇点估计的话 两到三国\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a3f74ea2-8082-4f8e-afae-3ce25c4f6066",
        "content": "{\"text\": \"对 两到三国\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c881d64a-f10b-4438-b9db-9a64c931ef8e",
        "content": "{\"text\": \"三号吧 什么 做好传 做好车避的布林\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f3931afe-2569-4c41-8420-dcde448022fe",
        "content": "{\"text\": \"找不干鱼波了 鱼波不挣钱了吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0672f02a-0040-4cc7-9038-534a2d1718e6",
        "content": "{\"text\": \"别动\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cfdc3bba-08ab-480d-a5fb-c2b6c2e1136e",
        "content": "{\"text\": \"鱼波不挣钱了吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "56660e33-ae1e-48d2-83ab-caa53a1bccb9",
        "content": "{\"text\": \"他打的 是吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e1bbe9c9-59bc-4b86-be47-c6d402215c4c",
        "content": "{\"text\": \"是 来个国字外边是不是\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "272b1724-35e7-425d-8ef0-000ed25f6680",
        "content": "{\"text\": \"他打的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "278fc435-12b7-4a7d-a531-9bef6bd282cc",
        "content": "{\"text\": \"他打的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "efd83140-7e33-41b4-8ea6-7c6a2cb81110",
        "content": "{\"text\": \"他打的是谁故意 生活是少 最后是什么\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7028ff06-6e2a-4ecc-adb3-97926f58b40a",
        "content": "{\"text\": \"越大和边的天气军的那\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
