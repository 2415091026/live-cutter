    "texts": [
      {
        "id": "0f9a1d53-0f4e-437a-987c-90fa5a216f1a",
        "content": "{\"text\": \"然后像北京这边 现在交区都已经四度了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "91f3abc0-d253-4bbe-9cb7-7250b3c836bc",
        "content": "{\"text\": \"哈尔兵已经领下了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "da2cf028-1f45-49e0-8719-a5ff2fc1397e",
        "content": "{\"text\": \"特别冷啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "67a40681-aa14-4c9c-8909-20e960acdb11",
        "content": "{\"text\": \"我们今天看那个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "afcc5fe3-e9d8-426f-bb20-f5053d40a791",
        "content": "{\"text\": \"活好特 将闻几五度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "58a50534-2af4-4c11-821b-4cb16fbd7a52",
        "content": "{\"text\": \"而且我跟你说 不光是北方地区\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "57b0d54d-8bdc-4b7f-9d04-46207d3fbb83",
        "content": "{\"text\": \"南方 我这时间最近已经出差一多\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c2d65e51-55cc-44e7-a992-b3b4efa51430",
        "content": "{\"text\": \"感受过南方的冬天来真冷\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fef5ba76-1616-4769-b9df-2e6c6cafd07a",
        "content": "{\"text\": \"真冷\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f6a2240a-c33d-452a-a3fe-9b6e20231d0a",
        "content": "{\"text\": \"南方地区 你就算物理开空调\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
