    "texts": [
      {
        "id": "2acbec27-1113-43e1-9389-5dbba3f2167e",
        "content": "{\"text\": \"因为最近温度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5111d34a-fb30-4bdb-9a34-d12832ba9da8",
        "content": "{\"text\": \"真的是普遍开始降低了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c4f9faca-575b-403f-a144-87577c3686cc",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ac036973-b772-4e63-b401-a0eccd12ce66",
        "content": "{\"text\": \"像北京这边\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "86855b25-3ef6-406e-a213-86263b0039a3",
        "content": "{\"text\": \"朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f1edbcd9-68f2-4465-ac26-0309019ab9d2",
        "content": "{\"text\": \"我们这事脆脆这朋友\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "66632aa3-a5a2-4544-88bc-a246a62144b4",
        "content": "{\"text\": \"我们这事实验环境\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "895ba8c0-25b9-4a98-bcef-694232b34815",
        "content": "{\"text\": \"叫实验环境\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "179e1c67-cd76-4b8a-a8ac-1643c3d379d0",
        "content": "{\"text\": \"虽然说就是这个证品\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "014243ad-7d80-43f9-b006-dacc00d3af29",
        "content": "{\"text\": \"但只是告诉你\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fa14dc0f-bbcb-4817-b406-f240e3068a04",
        "content": "{\"text\": \"回家不用怎么干\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c9382fb3-c37a-40f5-8afa-ded43bf56c9a",
        "content": "{\"text\": \"然后的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5fdbcb00-721b-4ed5-abd4-839097d3f9f4",
        "content": "{\"text\": \"咱们的家里边\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fcc86ef3-1726-4223-86fd-c5803e097933",
        "content": "{\"text\": \"比如说正常不要先撒了个水\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "947c6f50-518a-44c6-8f50-54ff5062d72c",
