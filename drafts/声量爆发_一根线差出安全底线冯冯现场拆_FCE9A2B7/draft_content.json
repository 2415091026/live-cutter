    ],
    "texts": [
      {
        "id": "10d3c4bf-aa79-4592-b353-01efc849b067",
        "content": "{\"text\": \"它的原理就比较简单\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "21b6cb57-64d6-4f9c-b3ce-febd2f84537e",
        "content": "{\"text\": \"您可以看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1126979e-f07d-4032-8b1d-9fce2a6ff66d",
        "content": "{\"text\": \"这个中间是一股生子\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "098dd54a-53fd-472a-8dab-c151fe26f5b8",
        "content": "{\"text\": \"然后在这个船上\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ebf57c72-6a1b-4e4b-b0df-82c41d5902ea",
        "content": "{\"text\": \"传绕着这样的发热丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d282b4a4-1e1e-4ae2-a90b-5e8fa8a3cbef",
        "content": "{\"text\": \"然后在外面一个局员相交\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ce9bee98-7872-448e-8701-59842c88b326",
        "content": "{\"text\": \"就这么一个简单的设计朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4cd0d673-235d-46cc-ae66-4fbea55b27e0",
        "content": "{\"text\": \"那你想想啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9130f1b9-dabd-4861-b36c-75e05b38a0ed",
        "content": "{\"text\": \"如果说温度现在过高了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "37af6612-69dd-4653-b5cd-6a75f08e13cd",
        "content": "{\"text\": \"这行的相交被烤化了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "76c5b8b7-c460-4d0e-9986-d093ffba18c0",
        "content": "{\"text\": \"那是不是就容易把你床单被烤点找了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e290c6c4-0889-4c17-8b2f-f4d6cb01d559",
        "content": "{\"text\": \"是不是很危险\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "aec9deb1-b747-43ce-8a05-28bd00556d8b",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d72cfb5e-fae9-4bc6-a40e-85bb951c4006",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e979cb0b-253f-4db2-b7c9-c1b52020914f",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fb0d0428-0fd2-495b-bba1-701f88a62259",
        "content": "{\"text\": \"它温度太高了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e51dbcde-7ec4-4dd0-ba7a-4550b8a2416f",
        "content": "{\"text\": \"那是烤化了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "72392c5b-4372-4bae-91cb-3d175641342f",
        "content": "{\"text\": \"可不就找了嘛\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "67b3b449-0c05-4805-a366-9b6644491c1a",
        "content": "{\"text\": \"对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
