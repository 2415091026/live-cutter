    ],
    "texts": [
      {
        "id": "b1e972f3-0918-4694-a6e7-1e023067cc99",
        "content": "{\"text\": \"所以你想想原本睡觉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d8ceadc7-ca25-4098-855f-6e1948c2e390",
        "content": "{\"text\": \"应该是一个很舒服\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3c436ad8-fcf3-4bd6-91b3-308b149390fe",
        "content": "{\"text\": \"很踏实\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c9bd4f77-a37b-49d2-8348-8ec298aad99a",
        "content": "{\"text\": \"很享受很幸福的一个事情\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "658c0be8-8ca6-4915-813d-95252b7fb5bc",
        "content": "{\"text\": \"但结果每天因为冬天\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "36fd25b7-31d5-4ff9-9d3e-3f2722d10a70",
        "content": "{\"text\": \"被我有良有食用潮\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0d55b1ab-6d37-4eef-bf43-654b03f2a1aa",
        "content": "{\"text\": \"我还得做一番心理建设\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8bbe881e-6e88-4219-b84a-ec8e44c003ad",
        "content": "{\"text\": \"就把穿着衣服进节\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "80ef2548-f5ba-4b0b-bb74-07ba68f25a8c",
        "content": "{\"text\": \"而且现在就不用过用的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "426d3b0c-80e7-45f7-9147-dddeb9131278",
        "content": "{\"text\": \"让它暖和下来\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7968e42c-def3-40fe-af33-a0e2305fc948",
        "content": "{\"text\": \"然后我才能把衣服脱掉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "21ef883a-f323-4cc2-bad9-052258809ffd",
        "content": "{\"text\": \"干嘛要这么难受\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7b05e191-6864-4688-aeb8-8b4d8e987ff0",
        "content": "{\"text\": \"所以咱们顶着谈给大家\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5bb5c1f7-e1b3-4c6e-8e61-62e2f7060c82",
        "content": "{\"text\": \"今天带来了这个专场\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c2dfa2a3-81cc-4ef2-b0b0-18e4ef9e2602",
        "content": "{\"text\": \"真的很合适\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9f99832a-22eb-45e0-9549-8a29dd1c35bf",
        "content": "{\"text\": \"而且现在全国普遍都在\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f57f4d1a-535f-4ee6-8985-00e7328b4900",
        "content": "{\"text\": \"大将闻\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5dda19bc-ab24-421c-8071-7edf4e20af4b",
        "content": "{\"text\": \"我们可以给大家说真实数据\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "97528f0b-c99c-4a70-9fda-f88fd58d70c8",
        "content": "{\"text\": \"今天我们这边看后台\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7da806b2-04a4-4075-bac8-b75b26a1dcc0",
        "content": "{\"text\": \"江苏这边卖得特别好\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "21576104-0b7f-4d3a-87e0-167fd5f5dcbc",
        "content": "{\"text\": \"我估计就是当地人\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "64a589b3-d73b-4361-8700-77b55da09bbc",
        "content": "{\"text\": \"真的给你动着了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "53832b18-4b20-4b58-ac9d-570a3a1c4e73",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "219a39fd-2c63-412c-a88b-5ecc10172d2f",
        "content": "{\"text\": \"要不这么多江苏人满\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "90ce3068-9ff7-4268-a45f-d81653affcd4",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "35d14583-dee4-4349-9fc4-8d52bad9844a",
        "content": "{\"text\": \"所以的话你比较小喊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bccb10a3-0ded-4c2f-b8bb-53ad43a74bdb",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "98f1659a-8544-4d2c-b1c8-d236c55293a0",
        "content": "{\"text\": \"那是背背的衣服来一个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "92b9f6fa-063c-4fd2-a1c6-11fa34e4a59d",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ec1c3611-840c-41f4-b74f-04898e86a8ad",
        "content": "{\"text\": \"来这个动画了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c3d7156e-ca3a-4c6e-9958-fa12b1112d12",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a5a24028-6cf9-47ed-99f4-14d60be614ca",
        "content": "{\"text\": \"包括这个鱼老师\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "efb733a4-c451-4f4f-bdef-ae497925fe84",
        "content": "{\"text\": \"很多都买一个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d0205e04-869b-4f6f-9e80-f31746a73f8c",
        "content": "{\"text\": \"那\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "31645ec5-30df-47bf-941f-edac992acb91",
        "content": "{\"text\": \"然后咱们这个的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fbf46b58-1320-4211-ba92-53d0e5f4ae92",
        "content": "{\"text\": \"这个今天给大家做的这个专场\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5fc63206-9b50-4c90-8ab1-fa59a5129bf5",
        "content": "{\"text\": \"就是这样\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4042786a-d75f-4164-86c6-4a7693e840d7",
        "content": "{\"text\": \"您看现在这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "36497878-56f7-4b0f-8b2f-f99e53d13852",
        "content": "{\"text\": \"哈尔铭已经领下一度了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c523a5e7-8c93-491a-8fcf-5c994b1a8360",
        "content": "{\"text\": \"然后呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "78d0ef79-484a-4afb-a0ae-829dd30d1b5e",
        "content": "{\"text\": \"北京那边据说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f506c13b-6c01-40a6-a56c-82d8f3fb550d",
        "content": "{\"text\": \"金就本周吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a49274cc-dd17-4a89-b5de-0405f943c993",
        "content": "{\"text\": \"也要下雪了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "84cdf241-d3c0-410f-ad33-0edc9aad8171",
        "content": "{\"text\": \"所以真的普遍在降温\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fbdd37d8-65b4-4ab2-94e8-fee11dbdc0ba",
        "content": "{\"text\": \"那么我们给大家\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ca8152a3-43f3-440d-bf60-de9197eb2685",
        "content": "{\"text\": \"今天带来了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "575c2a34-4ff7-4def-bf32-4c5d0b193229",
        "content": "{\"text\": \"就这种大场的品牌\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2aba86fd-b924-430b-be0a-a214497cde20",
        "content": "{\"text\": \"就是咱们的这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "69a3ac20-55d1-47f2-81c0-34912ae98bd0",
        "content": "{\"text\": \"太好了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
