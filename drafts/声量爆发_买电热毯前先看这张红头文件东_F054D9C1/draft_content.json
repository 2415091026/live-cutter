    "texts": [
      {
        "id": "49d3e174-a350-4d0a-bcd1-ed8f72aed7f6",
        "content": "{\"text\": \"产党真的是大品牌40多年的国货老品牌\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a5baeb1d-4857-43f6-acf0-db10ed48b2fb",
        "content": "{\"text\": \"对,床多大就买多大啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ae00bf6e-78e7-4eb0-878f-ace52ec8b3d8",
        "content": "{\"text\": \"然后这个的话还是咱们的这个40年的国货大品牌\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a8d1e497-efff-4a67-8844-19c3c467a23a",
        "content": "{\"text\": \"同时并且是电热坦国标的制定者之一\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3f5c12a3-8538-4683-b3cb-ceaeb618de87",
        "content": "{\"text\": \"所以足以证明人家的好一点,老哥的地位\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5df49a5a-ab53-4ec0-84bd-d0edc4a38907",
        "content": "{\"text\": \"我是三年纪学生,所以朋友们讲明这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
