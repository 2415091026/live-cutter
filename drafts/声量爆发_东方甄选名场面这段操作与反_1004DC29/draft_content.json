    "videos": [
      {
        "id": "e2b959d7-6592-46d3-9bb4-5b4897f5f087",
        "path": "E:\\代码\\美食街\\live-cutter\\recordings\\19-48-03_东方甄选_p003.mp4",
        "type": "video",
        "duration": 3600000000,
        "width": 1080,
        "height": 1920
      }
    ],
    "texts": [
      {
        "id": "fa0adae0-c5d6-40ed-9d3a-f240b2ca1290",
        "content": "{\"text\": \"融化了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "988bfd74-a1fc-45fa-9fb1-821dbc047d10",
        "content": "{\"text\": \"它融化以后\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1dca4ccd-a79b-4edd-b7af-1cd592412a6b",
        "content": "{\"text\": \"咱外面这个统丝不就跟礼物这发尔丝就联上了吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "56f60948-b0c6-4415-ae26-d41a5e2f2efb",
        "content": "{\"text\": \"那它就断电保护了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cb82703b-f58a-4d45-94cc-a378bfa9d53b",
        "content": "{\"text\": \"随时这么一个原理\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1a9459c2-2970-4717-8ed6-e9b9afd76f56",
        "content": "{\"text\": \"因此你看它最外面这一层相交为什么这么厚实\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7af4bac6-a1e3-4a8a-8f98-007e6b268b82",
        "content": "{\"text\": \"就是因为咱们礼物用的料更加的扎实\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7899a41c-3585-4359-a3d0-4c55b92be354",
        "content": "{\"text\": \"那所以朋友们跟大家讲\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "164fe0b3-b948-4c66-bf54-83986e7e5116",
        "content": "{\"text\": \"你想七日度就这个这么什么就用不了了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e52798de-f74b-423f-a265-a8083e879c15",
        "content": "{\"text\": \"咱们首先如果真的让它温度到七日多度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1ea172a3-5285-4954-bfc8-9fecfc2d20bd",
        "content": "{\"text\": \"没必要咱人体的皮膚直接接触五十度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e0b6fd5c-b477-4d71-989c-2bddff62a34a",
        "content": "{\"text\": \"都很难受了对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "35839c83-8511-4716-ab82-ee5d04039364",
        "content": "{\"text\": \"所以的话你这个正常温度让它\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "61686dab-e964-45db-a78e-b9f316539ce0",
        "content": "{\"text\": \"有个五六十度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c368c895-3d88-42d9-842c-e2e52a3660b4",
        "content": "{\"text\": \"然后在隔着这个一层相交\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7c4d7288-32d2-4a89-abfb-f92ab232056b",
        "content": "{\"text\": \"在隔着这个地\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "73c02f9b-5806-4dc7-8cf0-793b9c11e7cf",
        "content": "{\"text\": \"或者你的破裢的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7f554f8c-6e9c-4ddf-a5ff-a775d19f8d28",
        "content": "{\"text\": \"折到你身上可能四十来度就够了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "69fb6929-aa79-449a-98e0-621a0b98cbdd",
        "content": "{\"text\": \"咱能懂得感觉吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4b224884-1267-4eac-8fb0-dcf994c7fba4",
        "content": "{\"text\": \"或者说就比体温率高一点就够了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "72cec715-2a38-48a5-8912-c91765709591",
        "content": "{\"text\": \"是这个意思\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "59aae06b-cf61-4197-ba57-583c76867377",
        "content": "{\"text\": \"然后咱们今天除了这样的安全细数一外\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "02cf273d-5051-4484-9c84-f90723341a78",
        "content": "{\"text\": \"还没反同们再给大家讲一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9a66a028-8826-4e64-a4ea-92f82599dd25",
        "content": "{\"text\": \"你想这个电量坦上比如说咱们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cdbe14e4-4fac-4b67-b824-47b82276c593",
        "content": "{\"text\": \"不小心脱了水了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e47f0762-37bb-4cac-9594-5b06c92a828e",
        "content": "{\"text\": \"或者说有这个小孩子你要看了什么的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8fbb296e-e87e-4d55-9843-6292d520accd",
        "content": "{\"text\": \"你来看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7b705571-0b53-47c1-a4d1-99cadfad3076",
        "content": "{\"text\": \"我们这个现在电量坦\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7ea93e27-5deb-4112-99ed-d4a9dfb442ed",
        "content": "{\"text\": \"就是正在工作当中你可以看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5e9aed46-b82d-4344-a262-bcfec058105d",
        "content": "{\"text\": \"开的还是高\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5838f1fe-f0d7-41c9-86d4-f4c9a67ccefd",
        "content": "{\"text\": \"然后定时是这个这八小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
