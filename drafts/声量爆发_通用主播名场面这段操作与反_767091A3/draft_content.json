    "texts": [
      {
        "id": "982e1481-d205-445a-92df-0479a16027ce",
        "content": "{\"text\": \"鲜腸完吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d7c7b6ea-d8e0-478e-b3c0-14e2945cc0d6",
        "content": "{\"text\": \"现在加喝所就\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "48c1ba4e-29a5-4b1c-9581-846a6752b696",
        "content": "{\"text\": \"还原了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c9b3b383-c38c-4eaa-8173-40df27e7bcf2",
        "content": "{\"text\": \"鲜腸了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "55475386-39e5-4d44-855a-a2dd5cf0ab90",
        "content": "{\"text\": \"鲜腸了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1b0e998f-eef6-4e09-9660-375b1c1c63d4",
        "content": "{\"text\": \"鲜腸\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6fdb728b-559e-4354-9f43-3444b646d1a2",
        "content": "{\"text\": \"你对说家鲜腸的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "74ac7cb8-6d4d-492e-91b9-79c87b45d28b",
        "content": "{\"text\": \"那是不是鲜腸吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9f24fe5d-9365-4fa5-8f9f-cada3fdad891",
        "content": "{\"text\": \"我以为那是个英文的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2846caef-32ec-4625-95f5-b557d0a8ee08",
        "content": "{\"text\": \"喂,喂,打\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "740b65d0-ba13-4203-8aa6-5cdf63c2b629",
        "content": "{\"text\": \"喂,打一样,刻干,喂\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2b91809d-0dd3-4a26-8a1d-b7487352db4d",
        "content": "{\"text\": \"为什么之前白链\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "86826389-0b43-4133-8559-e84b3432b32a",
        "content": "{\"text\": \"白链包装是爬墨后面\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e006e3ec-5ac2-4499-83ee-138a0ec36908",
        "content": "{\"text\": \"点击注意\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dfa85b9c-3ad5-4013-8741-fadcfbe06794",
        "content": "{\"text\": \"那白链是只剩下的白链\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "173dee63-7692-48d3-9709-749b83608bd9",
        "content": "{\"text\": \"然后又对打一类下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "45cbe91a-bcf3-4a0c-b57d-64cc639e91e1",
        "content": "{\"text\": \"拍展的鲜腸可以否违门\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d0ebade1-2e68-483c-8421-59108d5e5c7f",
        "content": "{\"text\": \"老早给熟吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8d762c48-34f9-4a58-bed6-01fef1027ac6",
        "content": "{\"text\": \"决心\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "77efed1c-a86d-4629-aa76-d8545c5b5568",
        "content": "{\"text\": \"可以否找熟吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7c495797-87e9-4bb0-87db-1c3685236890",
        "content": "{\"text\": \"买草\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8a85672d-321a-4176-a838-c3fa1270ac70",
        "content": "{\"text\": \"没有\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "508ea104-59e0-456d-881f-1498a5804e7f",
        "content": "{\"text\": \"公祥片\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8ea88e50-c7f5-454c-b523-c03de82190ca",
        "content": "{\"text\": \"你肯定要文杀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b80916bf-7eda-4712-8827-d9c2ad3dc534",
        "content": "{\"text\": \"那身有我拍照\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9e078e14-b25b-48ff-affb-933612052bbb",
        "content": "{\"text\": \"你可以\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "de780a16-952c-4bcc-8f4a-f013ec709a45",
        "content": "{\"text\": \"扶扎\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "002435a3-b5fe-45bf-be36-4750a4fa6c51",
        "content": "{\"text\": \"是吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "14aa0894-37c5-4b8e-89fe-396f8412e4a5",
        "content": "{\"text\": \"等一下可以\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d864d2b6-55a8-4599-87a1-e6f826844761",
        "content": "{\"text\": \"可以否结果看到\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
