        "height": 1920
      }
    ],
    "texts": [
      {
        "id": "c777a0d1-eddd-4811-92fc-979aff07b9dc",
        "content": "{\"text\": \"等一米八的 还有零点八的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4906cfd1-f50d-4a96-b9df-da2e21d3d550",
        "content": "{\"text\": \"带人床 速射床 就买零点八\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "236b45e4-5788-4cad-b005-c3c13cca6912",
        "content": "{\"text\": \"如果是一名五的双双 就买一名五\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6d79a946-2c8a-4c98-9cd3-c21502239c26",
        "content": "{\"text\": \"一米八的双双 就买一米八 就是宽度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7b587970-77d8-4841-a283-29a903ff115f",
        "content": "{\"text\": \"好吧 这就是宽度 好吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "92962f23-80a6-45fa-a2cd-80f503280afc",
        "content": "{\"text\": \"这差点啊 这玩得充电一般不太行\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "184ede3b-e568-4043-b0b0-23bb0a7eb6c7",
        "content": "{\"text\": \"你只能不能要没有啊 最后的死打了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b87ddf64-36f4-4734-bb69-20346ca28f2c",
        "content": "{\"text\": \"不能洗啊 一号不能洗啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9b6d7469-3ccf-4948-a77c-cd2af2cdca8a",
        "content": "{\"text\": \"嗯 没有确儿 你换 换张号吧 不能吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2377a611-464b-420c-aac6-7f1e4a5d1b19",
        "content": "{\"text\": \"对 咱里轮上不用领动洗啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "36d94c83-f902-45fa-9e23-97923b72dd48",
        "content": "{\"text\": \"标准满抖音就对 睡一看上不卖这\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "07272307-4848-4d96-b659-e783936c480e",
        "content": "{\"text\": \"这好像 它们够找的微卖点来了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7380737f-df63-49db-9573-57bef9ab00be",
        "content": "{\"text\": \"本来也先买的 好吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c26b27cb-192c-4a76-9380-b96cadaeaf83",
        "content": "{\"text\": \"来吧朋友们 戴上他当时我穿这水衣宝看\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "81c2104e-c268-487b-bec2-ed5d5b6622b2",
        "content": "{\"text\": \"来吧朋友 你也主播你看上了吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d762a18e-2101-45f4-bbd5-9a012334e76e",
        "content": "{\"text\": \"来朋友们给大家看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ff21b76a-9e6d-41fb-bb28-6c5488ca1414",
        "content": "{\"text\": \"今天我们后台数据特别特别的这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "087977fe-7249-46f1-8b57-a3a3cb0fd8e5",
        "content": "{\"text\": \"清晰可以告诉大家\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3a134813-7e79-4fbe-b98b-631166e87681",
        "content": "{\"text\": \"江苏 江温 肯定特别严重\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2ec43df5-3473-443b-b3b9-98cf6a6cece3",
        "content": "{\"text\": \"因为今天江苏买的人 特别多\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0d341de7-3062-4c45-8efe-b9a2e92d3c7b",
        "content": "{\"text\": \"那估计是给当地的朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2a8c4cba-3616-465c-8020-6066b97a9358",
        "content": "{\"text\": \"因为动着了吧 咱江苏又靠海的吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b92b6c37-f18b-469d-9d90-5f7718abdd99",
        "content": "{\"text\": \"又有这个 江河要吴比较多 是不是\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f2c722d7-b171-4fee-b305-2e8e29b35719",
        "content": "{\"text\": \"然后咱们今天这个的话是给大家做这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "723a562c-0736-490e-b2a5-db7c026a5ddb",
        "content": "{\"text\": \"转场机制 价格那里发抱一下没问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bf9cca0f-f124-4efb-a7b9-cd1670f08022",
        "content": "{\"text\": \"一米八的这一百\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
