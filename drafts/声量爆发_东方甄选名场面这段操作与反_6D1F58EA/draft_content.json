    "videos": [
      {
        "id": "f5b7f6e3-0c36-4b6e-897b-f60cf1f7bbb1",
        "path": "E:\\代码\\美食街\\live-cutter\\recordings\\21-10-30_东方甄选_p040.mp4",
        "type": "video",
