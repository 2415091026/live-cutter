      }
    ],
    "texts": [
      {
        "id": "9a85c9b2-da1f-4a54-86c8-19a5066de16e",
        "content": "{\"text\": \"变中了按一下变低温了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7503816d-3106-4829-b0a6-f45e4d1f8f67",
        "content": "{\"text\": \"再按一下左边的关了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ad9fec1c-cd47-4826-afb1-7b36d5f00fdf",
        "content": "{\"text\": \"然后再按一下就又变高看了嘛\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "52a41d4d-3d0d-41e7-b9c1-69b3b386e09a",
        "content": "{\"text\": \"就一个循环见\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fe8a3ee9-85b4-40a6-afbb-76f509ca5b11",
        "content": "{\"text\": \"右边也是同理\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b19b6662-093c-414d-9a9d-b7c3cfb2d4cf",
        "content": "{\"text\": \"按肆下就是一循环\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f6444579-48c2-4c80-9f2f-c10052ed18a9",
        "content": "{\"text\": \"然后呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "68e627cd-5409-4029-8a6b-a0ad51447168",
        "content": "{\"text\": \"这还有一个定时间\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "673e71a4-63f8-43ca-9eb3-78ad71de800e",
        "content": "{\"text\": \"默认是12小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9ab7477a-755e-4122-9047-b0f98e0a636a",
        "content": "{\"text\": \"然后按一下变8小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ac943999-b860-4d8a-83fd-1d8522b0a6a2",
        "content": "{\"text\": \"再按一下变4小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9cf3a5e0-add6-4389-9611-a1f518b7f04e",
        "content": "{\"text\": \"再按一下右边是12了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5887eea1-3a7a-4c4b-b775-161f2e2a881d",
        "content": "{\"text\": \"3的就循环\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ba4bf024-e236-4c13-90ac-dbaceeedba51",
        "content": "{\"text\": \"然后再往上是一个处满见\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3a5479ac-604a-40a8-990c-7d1117cbe96b",
        "content": "{\"text\": \"比如说大家担心这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "791a4854-e51b-479c-bd5c-5d1143585f84",
        "content": "{\"text\": \"这个卫生问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e65d73ae-26df-4121-bfce-b4594312ad87",
        "content": "{\"text\": \"你就按这个处满就可以了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c2addfcc-604a-42df-bfb4-3873035e6afe",
        "content": "{\"text\": \"所以像老人咱们用也没有什么问题的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8d61808e-6052-4eb3-b9b5-6dc8be649b14",
        "content": "{\"text\": \"特别的这个好操作\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fbee101e-4a4a-4a04-b0b8-1d2b7512ed34",
        "content": "{\"text\": \"功率的话开始一个小时也就一度点\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2e5f84ec-af92-43e8-a3f0-d0b1ea459e0e",
        "content": "{\"text\": \"按高功率算啊朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "70514a27-c93c-4df2-97f0-83c1fba8d8f3",
        "content": "{\"text\": \"所以这个的话真的很合适\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7303361d-5a28-43bb-93d3-aac0cbba72c4",
        "content": "{\"text\": \"家里面朋友们现在冷不冷啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "81550201-a795-44d3-bdab-961cafab4091",
        "content": "{\"text\": \"真的冷不冷啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "51433d84-623c-46b0-ad42-10c1cee91c8f",
        "content": "{\"text\": \"您现在如果说开空调\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "15a78375-6558-4a21-89ff-f847fa3d9b74",
        "content": "{\"text\": \"尤其对于咱们老一辈来说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0122d44d-5b16-4d3f-9cb2-8c97ac32cf30",
        "content": "{\"text\": \"是不是特别担心费电的问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cc49cc9b-0619-41ac-b048-4f0705c8e5a2",
        "content": "{\"text\": \"而且亚哥用不逛空调\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e734afd1-0b27-4868-8f85-4de935cebd21",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8c0484ac-e97e-4055-bb0e-c96a34f7a916",
        "content": "{\"text\": \"然后呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "48da409c-fbdd-434e-9dcb-ca3358430035",
        "content": "{\"text\": \"再跟大家讲一个特别客观现实的事情\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b034ce8f-7fc7-470e-beb7-2e0df8f49c96",
        "content": "{\"text\": \"朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "33f7b6ce-0ab7-439e-b645-cc171b0f5f53",
        "content": "{\"text\": \"尤其南方地区\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f6b98f80-bc5b-48af-b017-0312e2acb2c4",
        "content": "{\"text\": \"北方呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3d3cf66e-7e31-4d3e-b8bf-917cd9e879b7",
        "content": "{\"text\": \"也也有这个情况\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "52d06077-42fc-4598-a461-329514fad98c",
        "content": "{\"text\": \"南方更明显\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c02271e3-e0aa-439e-b625-e6b6311737ba",
        "content": "{\"text\": \"你那个空气当中是朝的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ebfa73e4-44bf-445d-a1d3-d779c8c7ea4a",
        "content": "{\"text\": \"是施冷\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ebd6cb8b-7102-4f85-9b79-77084b4665c7",
        "content": "{\"text\": \"你开了空调\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "443df187-3ad4-45e8-86df-043ee3f01a1a",
        "content": "{\"text\": \"也只是物理败可能暖化价\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
