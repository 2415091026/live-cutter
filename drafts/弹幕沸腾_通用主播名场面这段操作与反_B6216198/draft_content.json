    "texts": [
      {
        "id": "d4459181-9f28-4711-9688-68ce27066852",
        "content": "{\"text\": \"把我把我来管我们来使这种\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d692d10e-ca98-432a-b8f6-99366ff1433e",
        "content": "{\"text\": \"完了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cb0983f2-b9af-49f8-af3b-5b5ef4ccb81d",
        "content": "{\"text\": \"那个本子呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2d7dad71-59dd-46a3-9ea2-fa50c7548001",
        "content": "{\"text\": \"他老这个根本锅的这个锅装在陈里\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3585340f-70f9-45bd-84b6-8534ab8fbac4",
        "content": "{\"text\": \"谈儿咱们呀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fa54a5c3-f55b-4ce9-8632-1df3b436e120",
        "content": "{\"text\": \"不谈儿咱们呀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b5573cdb-afe5-4b05-a9f4-021f607206fb",
        "content": "{\"text\": \"机老机早在我老看了吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3014b3b7-9792-4778-b639-4100d48f011e",
        "content": "{\"text\": \"我看不得早\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e1c451c7-20f3-4bb4-ba47-66cb24b713db",
        "content": "{\"text\": \"对对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ac88e8d5-ab85-4375-94d2-dcc5d2eb0d51",
        "content": "{\"text\": \"哦\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "eb8a4181-ff3e-4f1c-978f-4d094111419a",
        "content": "{\"text\": \"阿远你\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b87cff23-19ab-4559-b701-adcde7bd315c",
        "content": "{\"text\": \"咱们呀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e02922c2-8d14-4f82-a78f-0a70eb8ec09a",
        "content": "{\"text\": \"我手上\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4491d88d-1031-48d7-9fa5-209201f4405c",
        "content": "{\"text\": \"我手机去了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "36c19e71-d434-4dec-b1cf-31392ef6cbc0",
        "content": "{\"text\": \"流血薄汉年间\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "74a0ac3f-4281-427a-96f6-098ed3fd99d9",
        "content": "{\"text\": \"我帮她拿上来\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "531a7852-8b64-4420-89a1-e8fa37a1f137",
        "content": "{\"text\": \"流血薄汉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2224e261-54a9-49df-abd5-362b86f0b656",
        "content": "{\"text\": \"我经过去尝尝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5062f60a-e025-43dc-8f82-d79ce03e136f",
        "content": "{\"text\": \"我帮我帮老闪机\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1c66b699-0fa0-4696-8804-8c853dd135eb",
        "content": "{\"text\": \"你用来这儿充了其他队\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f8bb655a-9021-4519-9ce7-f9180c62becb",
        "content": "{\"text\": \"我下队你就说你\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b18ad10a-5bf4-446e-9245-5e873ac5a799",
        "content": "{\"text\": \"玩这儿充了其内\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3411bf3b-b5e3-4392-8826-1ddff054f408",
        "content": "{\"text\": \"那种故意我下队\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "62b80130-c5da-47b7-b835-e2d5b52a1571",
        "content": "{\"text\": \"小子\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e2837cd2-3abb-40c4-9d07-72185ecf5f4e",
        "content": "{\"text\": \"这个简傍在\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e463c7f3-4db3-41fe-8b49-9c93a76390a9",
        "content": "{\"text\": \"来\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
