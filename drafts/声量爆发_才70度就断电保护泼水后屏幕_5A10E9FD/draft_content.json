    "texts": [
      {
        "id": "d98edff9-4a46-4b38-a24b-aaac528b6a1b",
        "content": "{\"text\": \"才70度你就融了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c6a3bfb4-795e-43e2-938a-6d379086ea89",
        "content": "{\"text\": \"你就断电保护了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a9d2e50f-253e-4732-95df-d887d6fb9d04",
        "content": "{\"text\": \"那可不就很安心了嘛 是不是\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fb6e95cd-7196-430b-a22f-82f92b75c1a3",
        "content": "{\"text\": \"所以的话咱们这个的话用起来就特别踏实\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3c884c7b-1f80-496c-8f2d-12d55e8280b4",
        "content": "{\"text\": \"而且还有呢是什么呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "862e1be3-b916-4401-85c6-2cf8a1ef5475",
        "content": "{\"text\": \"咱们比如说家里边现在\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "90956f6b-cddf-4d2c-9b6a-58a9ef99b79b",
        "content": "{\"text\": \"不小心把水撲到电池谈了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6f4cd025-27cc-4053-aee7-bffb3ee6cb70",
        "content": "{\"text\": \"我这水也没难走撒了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "69b0ee64-0955-483a-a6f5-bc47a1bac325",
        "content": "{\"text\": \"对吧 孩子不要先尿尿尿了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8d461a26-3b9e-4dd8-8c14-d6fbe63735cb",
        "content": "{\"text\": \"没事 我们这给大家看更极端的场景\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dad61ede-f286-4650-896a-d8d1ed107117",
        "content": "{\"text\": \"来各位可以看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b29ccab2-dea5-41d3-a8e1-1b0907ea3caf",
        "content": "{\"text\": \"更极端的场景\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e7652b69-79ea-45a8-a734-529d4d42d7f4",
        "content": "{\"text\": \"咱们的这个现在这电池谈是正在工作的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7f858366-7ef5-4b54-b432-c0b706548d75",
        "content": "{\"text\": \"各位你可以看一下屏幕还亮着的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b312ed52-d88b-414a-a025-e3c2c74ae6fb",
        "content": "{\"text\": \"而且都\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
