        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "72337048-1ba9-4f4b-9d47-293b06f860e7",
        "content": "{\"text\": \"你看平时如果我们要做专场也就剪30\"}",
