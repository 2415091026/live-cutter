        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "55aa1abc-6b6d-468d-a04f-a59f32b0e7e5",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c160524a-3778-46df-965b-68f18523e652",
        "content": "{\"text\": \"我没可能就不来这一趟了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "12da484b-9d58-46f9-ba4b-b462a614e73a",
        "content": "{\"text\": \"但今天感觉双11\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "025d9701-3788-4e11-8536-bba7ad9402ac",
        "content": "{\"text\": \"还能再剪33\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "47e01170-b768-4b72-9f33-cb02ae8910be",
        "content": "{\"text\": \"所以一共的剪60多块钱\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "50f86ceb-ec45-4621-8943-4b5e96efca5b",
        "content": "{\"text\": \"不要们60多\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cd2e3292-0200-41c3-ae3d-db6301943116",
        "content": "{\"text\": \"你这6个人就赶点啥不好\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
