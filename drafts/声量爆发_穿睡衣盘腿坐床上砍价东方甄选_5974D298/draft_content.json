        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0217d9df-45ea-48d9-9851-8724401e46f7",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "702ebe6b-aa09-47a1-b283-e9de21c77560",
        "content": "{\"text\": \"所以咱们可以拍回去\"}",
        "font_size": 8.0,
