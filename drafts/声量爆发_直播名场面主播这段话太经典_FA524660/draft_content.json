    "texts": [
      {
        "id": "984e16bb-e08d-4292-8819-c47293431e2f",
        "content": "{\"text\": \"王文尼 还有疫苗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "534dd7ad-739f-4396-9b02-7af609e98e86",
        "content": "{\"text\": \"牛外\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dcd324f3-06ee-4f19-8c4d-39a9b4c10ed2",
        "content": "{\"text\": \"就种感觉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1f8a1872-0bab-4d12-83e3-6f5c33f32966",
        "content": "{\"text\": \"收拥过抛鞋\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5c3f52fc-0480-4264-a384-221a09dc1dff",
        "content": "{\"text\": \"装着复得还有一份\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8ea3ba7a-74fb-4a6b-9428-19a1c1f30e4a",
        "content": "{\"text\": \"能去那么剪关注\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "45c2a27f-8a2f-4a0c-907f-a845303b5309",
        "content": "{\"text\": \"拿着一台苹果是吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dba0c27d-de9c-4d4d-a092-bb7969ff99b4",
        "content": "{\"text\": \"没电话说什么都没电话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0d9cfacf-b39a-47d9-94cd-4a3c3c2af9ab",
        "content": "{\"text\": \"我也来再给什么发\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6c7be5ea-9278-4e54-8c3e-bc0c085d2b59",
        "content": "{\"text\": \"发5个以外的团服务贸\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fb5295ad-8d2c-4f90-9f79-fe111b95f5e8",
        "content": "{\"text\": \"再发5万\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "09a47dba-de56-4d5e-82e8-0bb05d31d1e2",
        "content": "{\"text\": \"发尚\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e9c3bc0c-250d-46a2-8a76-b548c5f87f2b",
        "content": "{\"text\": \"那那么就这增牌\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "761e7924-c2c0-4583-b918-b3528e7c3358",
        "content": "{\"text\": \"发10个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8128da22-1a13-452d-9def-269a46b543fc",
        "content": "{\"text\": \"发10万的红包\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "975bd80f-c158-4b06-85ed-920d3670495c",
        "content": "{\"text\": \"10个以外的团服务\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a19e459e-5cc8-46f8-9242-03d675249294",
        "content": "{\"text\": \"我把警战\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "16095bf5-7a55-4458-a0e6-019f0f7f111c",
