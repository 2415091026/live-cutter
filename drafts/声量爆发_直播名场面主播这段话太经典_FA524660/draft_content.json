        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "da494695-c037-4f27-98de-a2e09a510390",
        "content": "{\"text\": \"参云云云云云云\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2c8733d4-3558-4b8d-a208-72a083a9c50f",
        "content": "{\"text\": \"一个红包有两千多份\"}",
        "font_size": 8.0,
