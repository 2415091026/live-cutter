      }
    ],
    "texts": [
      {
        "id": "63a8b2fc-2781-4284-bf6c-87f4a8a6e2f2",
        "content": "{\"text\": \"安心 又保暖 辛苦 栽心\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "35f9da04-9c36-46ad-8026-8b12fef3970e",
        "content": "{\"text\": \"转移 抱一下胖的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2e0b311c-15fe-4a3f-b560-1a1efb815e34",
        "content": "{\"text\": \"不用耐心 脉胖的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fde24c96-8b3b-4386-84d4-855a77c96391",
        "content": "{\"text\": \"现在就说是你的耳梯\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "61d70781-057c-4814-b833-e2af287f8912",
        "content": "{\"text\": \"说是你的耳梯\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "917ea2ab-8dda-40de-aaa7-61dfc41b5f34",
        "content": "{\"text\": \"大家都是非常不熟悉的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "17b4d8f8-da84-4fcb-8533-32c96d88041a",
        "content": "{\"text\": \"你只要在等手上\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9dee887e-3f59-4d89-a176-12f34e6b5904",
        "content": "{\"text\": \"全部放在鲸櫃\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cb5e6274-827a-4794-8759-6481816eac98",
        "content": "{\"text\": \"你的耳梯的人在耳梯下面\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "de6a6294-4a22-4435-bfd7-33993c2251c4",
        "content": "{\"text\": \"就想告诉我\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c261c813-9b0b-47e4-bb85-6b7e1bfca80b",
        "content": "{\"text\": \"不要再走吃\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "59f38a3c-1e59-48e1-83c8-d3be62a81a69",
        "content": "{\"text\": \"会去刷家中吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c6fba98c-0d33-4d8f-8ef2-a152d16c238d",
        "content": "{\"text\": \"是的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "db287953-3be6-4c5a-b50f-3243c422f657",
        "content": "{\"text\": \"妈妈 来跟大家说一下怎么去用呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f12639ab-bd32-4862-bdd9-2778da01b835",
        "content": "{\"text\": \"说不能破了还后\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3583a15a-ea5f-47a8-86dc-803ebcfb2ef9",
        "content": "{\"text\": \"什么呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9dd0e1a0-b616-410e-ad90-8c8aff9b8074",
        "content": "{\"text\": \"来来来来来来来 给他看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "eda4bca4-c7ad-46eb-83d3-88ffab90d727",
        "content": "{\"text\": \"来 这个的话呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e726a9d9-5427-4db2-9c1c-59db4e130092",
        "content": "{\"text\": \"就是您正常用的时候\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "506c2bf4-3342-4ba5-835a-5519cf7a7b9a",
        "content": "{\"text\": \"在上面撲\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1e5769ed-1368-4642-a631-59d4f1295070",
        "content": "{\"text\": \"那个比如说那个床汭\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a1f64a58-6b31-4815-954b-43917bda700c",
        "content": "{\"text\": \"锁鱼\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "98d34113-8e56-4236-a649-c652bd4a507d",
        "content": "{\"text\": \"锁一个小弱子\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0b61d368-5a18-4c08-9752-551b2a4c6f49",
        "content": "{\"text\": \"这都没问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f6de205c-f274-4bdb-953b-1ecd12d54cdb",
        "content": "{\"text\": \"但是别撲什么呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6d2fcada-932c-43c2-9b10-ed9c4197c903",
        "content": "{\"text\": \"户神\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6658a79e-03b2-4eb7-bf87-8ca27bdb9c36",
        "content": "{\"text\": \"户\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
