    "texts": [
      {
        "id": "e07ae4c1-85f7-4512-aab9-c01220d9f302",
        "content": "{\"text\": \"我都可以等海蕾桃\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b072c085-1a41-4ad4-ae80-44440747cce2",
        "content": "{\"text\": \"对吧 没有没有那种\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6bbc37f1-b94b-4dbc-81c4-fd55cbeeb04b",
        "content": "{\"text\": \"莫名形料的食物了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d4a1a870-b9cf-416a-a34d-92c6a33c7147",
        "content": "{\"text\": \"加油 加油\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "acaef8b8-e405-4634-86fa-1cf9a736fac5",
        "content": "{\"text\": \"状态拿出来 好吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d3ae5894-1f14-4650-9fb7-549fb1897d12",
        "content": "{\"text\": \"装着有一台苹果18区那么执续\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7ccd443b-6d28-4e27-9a1f-4fc3ceff857f",
        "content": "{\"text\": \"要点个关注\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2496b875-6542-4475-a0b7-70bcdf3355f7",
        "content": "{\"text\": \"点关注中奖\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fef762e2-7f3b-4487-b360-ca2144952812",
        "content": "{\"text\": \"给你还苹果18\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "740468db-4da8-4ddc-add8-eddcb3325cbd",
        "content": "{\"text\": \"没点关注什么都没有\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "82cb8c31-4ec3-4654-8f0f-9c759d8993db",
        "content": "{\"text\": \"对面也在开直播了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7802eb55-9c77-49b8-bf39-f53c229830d3",
        "content": "{\"text\": \"点那边名字就可以进入\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9833e8eb-5743-4827-8728-8c4c92d9a5dd",
        "content": "{\"text\": \"这个看它看它们的视角\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "db6a0462-df72-45f1-b2e3-049224cc1501",
        "content": "{\"text\": \"你们过去打薄酱油\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
