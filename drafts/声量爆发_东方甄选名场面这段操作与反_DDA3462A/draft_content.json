    ],
    "texts": [
      {
        "id": "75ec9dce-59f5-437a-9bed-0f80987ed5a0",
        "content": "{\"text\": \"用没问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "78e2a9b0-d546-42c7-9050-056af62c2b8a",
        "content": "{\"text\": \"你别滑着就行了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7c0ac95e-8bd8-45ec-882d-8c6d2e7b32de",
        "content": "{\"text\": \"然后可以看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c6167019-7bdb-43c3-8e46-b5ad9e9c836c",
        "content": "{\"text\": \"咱们一名五的是特别主流的双人床\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "02fbcbd0-f846-4566-b168-064cef07dbd4",
        "content": "{\"text\": \"这个这个我介绍一名五的床吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b6abd337-fcce-4ac6-bb84-2e1b6a71d5a5",
        "content": "{\"text\": \"日常卖198\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0ca8dce4-91a4-4da0-ad65-6ecd4701ed68",
        "content": "{\"text\": \"您可以看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "05aa20ea-fe2d-4e79-bb95-068038423cde",
        "content": "{\"text\": \"真的是卖198\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "521eb7dd-03d4-4feb-98fa-868d7bb31a8b",
        "content": "{\"text\": \"今天的咱们双11\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6c1a2afc-3b14-4098-a661-a07aa607265a",
        "content": "{\"text\": \"所以别等别犹豫\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a240962a-53c5-4415-aaba-027480912e37",
        "content": "{\"text\": \"双11一定比日常的专场\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8f8ad3f2-2295-4599-8281-9e7f3bcef435",
        "content": "{\"text\": \"机制更大\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d9a337d3-7998-4cfb-a4ca-90b867ec4062",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f50c2c00-50b9-46e4-acfb-19d51a52f44b",
        "content": "{\"text\": \"两重股贴啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2fb4a7e2-85ae-419d-b869-af9ed83d97b3",
        "content": "{\"text\": \"先给你剪3-3\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9738a3ae-36b8-4931-9126-3ee71c5cdf1e",
        "content": "{\"text\": \"专场给你剪3-10\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "44f3cfab-1f8c-40d4-a988-a7257a2331b9",
        "content": "{\"text\": \"离外离给你剪60多块钱\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "958f64be-605d-4690-b130-86a9d5ba36e4",
        "content": "{\"text\": \"咱们126\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "151e0743-ba79-443d-985d-7b63e7567e7e",
        "content": "{\"text\": \"相来打了个6折就能到手\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8c0c2687-fb29-4530-9840-266de66751e1",
        "content": "{\"text\": \"好吗朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "93e6ca42-6f67-4c5b-8782-36086a8d5a00",
        "content": "{\"text\": \"嫁格真的很好\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d579f4bb-9832-44fa-862b-e1eb3c4ee103",
        "content": "{\"text\": \"再有的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6c049cf3-cf93-41a5-a3e7-331ea3f9ecf8",
        "content": "{\"text\": \"就是咱们的尺寸\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "05f336e6-5bf1-4921-9786-bff655f902ad",
        "content": "{\"text\": \"你要是一名五的床就买一名五\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d6b4d86e-6ea8-4310-a089-d96b2c732ca2",
        "content": "{\"text\": \"一名八的床就买一名八\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "51fe6478-c95e-412d-9a8d-7bb62ea38aed",
        "content": "{\"text\": \"您家如果单人床或者数设床\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ac9f7f22-cbfb-4f67-9f5d-09ae21f7c3b1",
        "content": "{\"text\": \"咱就买0.8\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "52a1affd-c381-40ff-962b-92151d468ee0",
        "content": "{\"text\": \"就够用了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "18dbdb52-e32d-442b-9a0e-924ba69b909e",
        "content": "{\"text\": \"然后这种店上它本来\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "280e8f75-c3db-42e1-a216-4d991783fba8",
        "content": "{\"text\": \"就是略危大一点点\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "32cf1481-001e-435d-b0c7-0ad6647d7704",
        "content": "{\"text\": \"略危小一点点都没事\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d4ab895d-8a9b-47cb-bc96-9bc140abf2d1",
        "content": "{\"text\": \"因为床在家床\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3558b909-566e-4463-8865-e2d29da654d1",
        "content": "{\"text\": \"在家入子\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ca0ad28e-11f0-47a3-895d-021a2531e4fe",
        "content": "{\"text\": \"本来就没有颜色合作\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "89d62e58-be58-47c9-8de3-b50188173882",
        "content": "{\"text\": \"对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f4a2c312-0d61-48a0-815c-cf04804f0690",
        "content": "{\"text\": \"所以没关系\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3a5ec145-6d90-4927-8234-de39d7d9fc15",
        "content": "{\"text\": \"咱们家那个价格\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "58888aa4-8fac-4a40-96cd-edfe653a9466",
        "content": "{\"text\": \"特别香不多了吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "21ef591f-b6c7-4d49-acdf-1db0cbbb4296",
        "content": "{\"text\": \"应该\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "058de95d-ee19-41d6-a250-d2830094de5c",
        "content": "{\"text\": \"没有了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "67bcc034-c1a0-4f89-92a6-4d2288ad5b82",
        "content": "{\"text\": \"那早办呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "79d1a1ca-1dc8-4941-90a0-89a7a423d06c",
        "content": "{\"text\": \"那我们下播吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "aeb6962e-74bd-4955-a195-33dc5c7ad1a2",
        "content": "{\"text\": \"朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a702369b-ae72-41a1-9bbc-73b03757964e",
        "content": "{\"text\": \"这怎么他们关系\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d2fbc1e7-51af-4d97-b82e-aa9544bfe306",
        "content": "{\"text\": \"就是\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e6ff4701-b6f4-46b2-a9c1-40ef5929a847",
        "content": "{\"text\": \"有46单从人家店里边自己挪\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
