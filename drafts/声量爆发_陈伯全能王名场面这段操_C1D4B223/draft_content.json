    "texts": [
      {
        "id": "cecf00d9-bcb2-4e36-9d94-414292b76735",
        "content": "{\"text\": \"就只能比国打六把一双来\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7b5b4f24-b7f2-448e-9f4e-5a2162c2283b",
        "content": "{\"text\": \"再给我坚持六王\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2254ecd6-fa26-4631-acae-16b9eec2c924",
        "content": "{\"text\": \"哎你后里都还一条\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a801fa8f-529f-43a6-aa6a-1cf6443d2e8f",
        "content": "{\"text\": \"上\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2d8fb82d-a888-4374-b40a-1d549fe3b7ff",
        "content": "{\"text\": \"我也发两个一万的团子\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ba98d92a-8eec-4f2d-8851-eac6ef231683",
        "content": "{\"text\": \"发不了现在\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d207e338-36f1-4b3b-929d-c3f753201427",
        "content": "{\"text\": \"我是七分\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "60a8dd43-9fc6-405c-9b87-d4323504bcb6",
        "content": "{\"text\": \"给你再抓点\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d122777f-d2e9-4b65-bfb7-56d8cebb9f25",
        "content": "{\"text\": \"扶在产品下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c144de5c-9b85-40e0-b0d2-8db82601eb37",
        "content": "{\"text\": \"什么\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "16740b64-1a3c-4821-be75-2bb3f12895e6",
        "content": "{\"text\": \"给他放肚\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d192a651-1653-4099-bdec-46f47a956d30",
        "content": "{\"text\": \"还是二十万\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c54d6788-0db3-4b04-8500-2779efaf08bc",
        "content": "{\"text\": \"可以吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ccace424-6fbf-4a0c-a386-d019ae4c0af1",
        "content": "{\"text\": \"我们这面手足不好\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "19489cf4-2b29-48a6-bb31-20887943c886",
        "content": "{\"text\": \"二十万发足不坚\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c0c98b08-6598-4349-a4f4-4c418dab0607",
        "content": "{\"text\": \"这边要一闷的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d0949455-8c1c-4ff6-9677-5b60596a76b6",
        "content": "{\"text\": \"二十万拿走\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
