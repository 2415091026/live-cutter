  "materials": {
    "videos": [
      {
        "id": "994c3a66-49d5-4d69-8ca6-adef42784f89",
        "path": "E:\\代码\\美食街\\live-cutter\\recordings\\21-07-41_东方甄选_p038.mp4",
        "type": "video",
        "duration": 3600000000,
        "width": 1080,
        "height": 1920
      }
    ],
    "texts": [
      {
        "id": "52f68857-343c-491f-a296-c171d2bd12b0",
        "content": "{\"text\": \"咱旅戴个黑衣服的抹带\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4398d694-d6e9-4d8a-ba45-d792d18a8c30",
        "content": "{\"text\": \"等您的大家不要再到\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d94dd823-70ea-4a07-800b-ed0d490ca1eb",
        "content": "{\"text\": \"不该后面的双扎\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7cff91ee-2620-4da0-8171-9db27ca76278",
        "content": "{\"text\": \"您有问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "513a4a31-939e-4583-ae03-2e48ee67e6bc",
        "content": "{\"text\": \"不用来席海衛的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1c9d80f4-e574-4201-bceb-27bdfec7b4ef",
        "content": "{\"text\": \"都在持续的一样\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4f1b9ebd-119e-488c-a72e-9fcfa84d14db",
        "content": "{\"text\": \"我们看别人后面\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "25d9f138-d908-4731-a0b1-bfa66e7b1645",
        "content": "{\"text\": \"就要运动了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "13ac8e46-8e2a-4d1e-b0ee-ec6453694415",
        "content": "{\"text\": \"越来越冷\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f6c195aa-7670-4f92-a611-007a43ec824c",
        "content": "{\"text\": \"这就要披到非常了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6bd72f0e-c69b-4000-b391-cfeff66e86b1",
        "content": "{\"text\": \"实际划结要爆带\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ca941355-ec6a-4df9-86f1-065c95ced556",
        "content": "{\"text\": \"上面可以盖着备在\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e7db2444-b976-4141-905b-871034bec61d",
        "content": "{\"text\": \"然后盖着那个床单备着\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9a83f780-b171-4f87-af46-b36cdab7765e",
        "content": "{\"text\": \"都行\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c9996003-92ed-40e4-9aea-306d89c35430",
        "content": "{\"text\": \"小入子都行\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "15892af1-37fd-427b-ac73-b46034974ff0",
        "content": "{\"text\": \"只要别盖\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4b6c73c6-4a59-4cc8-bb77-5d3e5e1d2464",
        "content": "{\"text\": \"不透气有特别厚的东西\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "671d311d-bc43-4c18-88aa-96becaaf5b90",
        "content": "{\"text\": \"一直盖着中压就可以\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7ac5e74d-931f-4fc7-af1b-41be6b7119f0",
        "content": "{\"text\": \"然后旁们看一下怎么用\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2c4abcd6-e025-4c2b-ac95-9168880ac34e",
        "content": "{\"text\": \"开关就这个大届特别的方便\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "85bf6a85-dd56-4f43-b3e7-b95e42477746",
        "content": "{\"text\": \"往上一波就行了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "48b7ad67-87f1-438b-8b63-e19f40667c75",
        "content": "{\"text\": \"然后这个屏幕就亮\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
