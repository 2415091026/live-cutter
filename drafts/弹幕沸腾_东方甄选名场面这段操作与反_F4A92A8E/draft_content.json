      }
    ],
    "texts": [
      {
        "id": "b58a6347-1200-46e8-8d7d-2d52ad62f35f",
        "content": "{\"text\": \"有90天的翅膀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ad589eb1-f833-40a3-9562-b998938d20a2",
        "content": "{\"text\": \"而且给您保下到了明年2月的月底\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8175eaad-8c2f-40d4-9eab-54a457fc44c2",
        "content": "{\"text\": \"覆蓋了今年的双12和明年和年\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "df4d429c-5270-4e85-b486-0fde66a48dd9",
        "content": "{\"text\": \"过节\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e2c46f3d-1c8e-4303-911c-6e71630f0442",
        "content": "{\"text\": \"可见我们今天下个真的非常非常好\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fc6931b4-4867-4466-9bf0-941340878f1a",
        "content": "{\"text\": \"之前就是一个问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "71f609fa-a2cf-4d72-9b3b-455e48515d2c",
        "content": "{\"text\": \"就快没够嘴了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1ef69bec-93e8-4101-b396-e45085429bc3",
        "content": "{\"text\": \"刷新去拍吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "82a3a3ef-92d3-423e-9d07-f04b4fef7d4c",
        "content": "{\"text\": \"对了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bfb11cdd-c6ca-41a3-8837-269397676745",
        "content": "{\"text\": \"我为后来\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8e513fd1-0296-47f7-a574-d8c2ea64c8b1",
        "content": "{\"text\": \"来吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "69263717-e294-4e64-a886-1f9aa53a5524",
        "content": "{\"text\": \"到几个三分钟的一个时间\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ca133dc4-9149-4b49-b020-a960ad5538f0",
        "content": "{\"text\": \"我集中回来问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9a65c20f-570b-4736-aa43-38f5a5a24f27",
        "content": "{\"text\": \"首先点正把这麽开门拍大\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a636f50e-b277-4736-9bb9-6a5897b0e607",
        "content": "{\"text\": \"因为它是个驾荣的一个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3d23a6ec-c88c-42b5-9056-ed1419603979",
        "content": "{\"text\": \"驾荣那个跑鞋\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "117627a8-0bf8-417b-a21f-e5d1f435e56f",
        "content": "{\"text\": \"所以已经把那个融得厚度给您考虑\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0f927c99-65a3-4d74-88e6-c6cd8693bf16",
        "content": "{\"text\": \"硬续了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1e7840c0-6f07-43fb-8f91-07241b39a9e8",
        "content": "{\"text\": \"评认算三八\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "65c3f80b-e163-416e-8392-acae16b077d6",
        "content": "{\"text\": \"你就买三八\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0ab0d415-4aca-47c4-ae4a-abd96765c297",
        "content": "{\"text\": \"评认算四二\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "49f1dc33-5afe-4eef-93b5-568740671b97",
        "content": "{\"text\": \"顶就买四二\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2aceac8d-50a5-48de-8df8-eac27bd748eb",
        "content": "{\"text\": \"没有任何的一个问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "94521287-da97-4f8e-87ad-769068b61858",
        "content": "{\"text\": \"女生优先推荐我手上这一双音花\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "531b603d-63b7-4437-9fc4-acf37d743bb3",
        "content": "{\"text\": \"很特别的好看\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "33e6fa55-089e-4309-9916-964e80d3d17d",
        "content": "{\"text\": \"因为这个粉色\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b513f3cb-34b4-4829-9103-5bd0d3292a5e",
        "content": "{\"text\": \"它不是保护度这边高的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "21b6c770-c84f-42e8-a03d-37160b873e81",
        "content": "{\"text\": \"保护度特别的第一\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8f6f22e3-24ea-41f2-914a-e7e74e92bc54",
        "content": "{\"text\": \"您无论怎么\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ad1a93f2-9d06-4a5f-a086-caeab64302f7",
        "content": "{\"text\": \"大会都特别显气质\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6077bc3a-e75d-4810-a13d-ecea14d969f6",
        "content": "{\"text\": \"如果说您是男生\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3dd72daa-4b09-43a2-ab9f-cbff82439ce3",
        "content": "{\"text\": \"去选的这个黑色的就可以了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5c681d9d-b805-4bd3-95f6-3e5413ed684f",
        "content": "{\"text\": \"成文去习门的个位\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1787f88a-723a-4f9d-8e49-8cd6c9d7f2a5",
        "content": "{\"text\": \"谁都能穿\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8a7b65af-aa37-4ae4-acca-d214823e66fc",
        "content": "{\"text\": \"全家老时候都能穿\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f1c89016-f451-4654-86c6-b0615e51de59",
        "content": "{\"text\": \"为什么\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "85b01208-6ab4-4722-be22-3934e8170073",
        "content": "{\"text\": \"你现在买的这个鞋\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c6691d7c-df13-425f-8dac-2d47d1c9ff77",
        "content": "{\"text\": \"因为全国都已经大江湾了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4974f64e-c385-44e2-849f-7555b3236ae6",
        "content": "{\"text\": \"北方都已经领陆陆一下了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ae8d7371-56d6-41ce-85b6-e3c2ee073444",
        "content": "{\"text\": \"江湛互队有五度一下了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "55f81a51-cbfc-4880-9417-7e5d4a386d79",
        "content": "{\"text\": \"动人先动脚冷风脚底酸\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "81975b86-0604-40bd-83e6-03724c9a93a7",
        "content": "{\"text\": \"但对于这个来说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "343044c7-d6e1-4ad0-a75f-68f6db51ed59",
        "content": "{\"text\": \"全方位的家中\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "55ccbd9f-2cff-41f0-b36c-6d80a3a039e1",
        "content": "{\"text\": \"不是表面\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "beb6b77a-acca-49ea-9dcd-159eaa9c8e12",
        "content": "{\"text\": \"但但你家中\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d5580796-f4e7-4fbc-b8c5-46f8d3748854",
        "content": "{\"text\": \"记住联弹你的鞋调\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ec7abb61-9a93-40e9-801a-f990df764335",
        "content": "{\"text\": \"联弹你的表面\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3570eac6-6460-4990-9b2c-aa487b47cba0",
        "content": "{\"text\": \"全部都是家中的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4e68596e-097d-4dff-9d92-5041df95bb9d",
        "content": "{\"text\": \"所以记住全家老时候\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4efa86b4-2368-4b74-a582-e279bf18778f",
        "content": "{\"text\": \"动能穿从脚底酸到脚怀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "819bc2af-67a2-44e1-8a3a-f85754f32a54",
        "content": "{\"text\": \"还是那么大中间的六点钟\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
