    "texts": [
      {
        "id": "7b01fb24-d68d-4ba3-aae5-2a33c57a2b63",
        "content": "{\"text\": \"嗯 过来因为它是环美观念\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3451ee03-97f8-498d-b04c-d3dc2f0399c9",
        "content": "{\"text\": \"你不说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2c0b9cb3-93a8-48a6-af53-337a38335d6d",
        "content": "{\"text\": \"它就是环美观念伟大\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c61e2f26-cd0f-4ee2-9e43-c64f33137997",
        "content": "{\"text\": \"行模一样\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1b493d08-ccff-4efd-9966-f567a4bf2007",
        "content": "{\"text\": \"给环美观念伟大行模一样\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "720dc00d-c529-4cec-bf41-f4341e9ee52d",
        "content": "{\"text\": \"对 但之初它是环美\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "beb6e12d-2f0c-4437-a14a-dee8bb73aec6",
        "content": "{\"text\": \"对那\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "57d67ad3-2df2-4798-9024-ed596f4e33c3",
        "content": "{\"text\": \"它的伟大跟环美观念一样\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4ac94e59-9309-4489-96cd-8f7ae7dcaec0",
        "content": "{\"text\": \"使完吃环美观\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "319b5ed9-be59-417f-a66d-2a39ece38937",
        "content": "{\"text\": \"你拍周图就没有你\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1525cf5f-4ab1-4863-b5c5-3737f81ea0b8",
        "content": "{\"text\": \"我来听不见\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "aac1a40b-5001-4e35-8e66-2f9678a43a7b",
        "content": "{\"text\": \"周园比环美观客干好累\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e3c7f7a5-4c61-4c82-a240-9543f286d593",
        "content": "{\"text\": \"它是环美观念这种触经感点\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "990a6138-32e8-4e47-ab84-ea864c0f54cf",
        "content": "{\"text\": \"有触触\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9959b06d-e967-4cff-ad17-6f20315fe746",
        "content": "{\"text\": \"对比环美观好传\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7d4f5cd1-61e2-4a90-985d-f389f2dda670",
        "content": "{\"text\": \"没什么感\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "557652dc-c15d-4a41-8227-7469a8266f19",
        "content": "{\"text\": \"没什么感\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a4bca74b-52d8-4c0d-a364-71ce737db81e",
        "content": "{\"text\": \"你这块老大这儿学成一样\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8af59c10-af4e-4099-a610-f655dd72cefb",
        "content": "{\"text\": \"一样 这吃的吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0406c7d3-99fc-45d3-960c-d30763248fda",
        "content": "{\"text\": \"对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cdce180f-2eae-4801-9b18-999e870a0d61",
        "content": "{\"text\": \"对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ea2d1a1d-b3fa-4d93-ba55-dd76a90195ea",
        "content": "{\"text\": \"没有点好\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "57024b8f-0eb8-411b-83c2-c77e05fe7d31",
        "content": "{\"text\": \"我想要再慢一点吃完了吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e8d3af59-c206-4416-93ba-082ea0602fce",
        "content": "{\"text\": \"吃完了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6bdae2fb-d79c-47ab-9996-f22d527a769a",
        "content": "{\"text\": \"吃得来不动\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d91181ba-2d20-436a-8abb-78cfab5b4c2b",
        "content": "{\"text\": \"既然你的吃完了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "367957e4-9644-48a6-9436-83986b1e574c",
        "content": "{\"text\": \"肯定是吃得难的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "67d945dc-a746-4fc1-94f5-8fa24162b11d",
        "content": "{\"text\": \"我不吃\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9500be8e-2da7-4aa6-ad94-b310828bb939",
        "content": "{\"text\": \"对你这位情随\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "46aab3b9-5a07-4028-8d14-8a86081e7f36",
        "content": "{\"text\": \"旅岸随般的环美观\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "233bc27f-32ab-4f2b-a654-f20fa91a07fc",
        "content": "{\"text\": \"好\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "193bc179-adad-4ecc-b573-2b4c8aeff934",
        "content": "{\"text\": \"来\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b8ae0a9d-a379-40b5-9602-8991f2de83e6",
