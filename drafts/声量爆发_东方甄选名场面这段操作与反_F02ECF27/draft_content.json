    "texts": [
      {
        "id": "7cbdf630-46e0-43f7-9746-a561a519f391",
        "content": "{\"text\": \"发热丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6fd71bc9-5506-4ff9-a672-fc7880a46eec",
        "content": "{\"text\": \"所以当温度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c14fc8d7-8cca-4ec9-8de7-82507d8b8e50",
        "content": "{\"text\": \"如果真的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "74d0be90-5589-405d-ac81-37a4576c6ead",
        "content": "{\"text\": \"你五着或者怎么着\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d85b65d8-1b39-4f3c-b9bd-1922ac0cb41c",
        "content": "{\"text\": \"温度太高了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "71cf563e-032d-4a2f-be6f-9857611ca333",
        "content": "{\"text\": \"到70度了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ba504da4-d591-4888-95fe-61397fa7fb47",
        "content": "{\"text\": \"这层相交就融了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fe1023a2-29bb-4f08-8928-466cddc68b2f",
        "content": "{\"text\": \"它一融了之后\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ba4357e9-0683-4b18-9f48-209110513f5c",
        "content": "{\"text\": \"礼拜的发热丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c98993f2-c341-4a5f-b0bb-b67077eaf20e",
        "content": "{\"text\": \"跟外边产着这个统森\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4f2535c8-668e-46a7-81d0-cf02c6d936f4",
        "content": "{\"text\": \"就接触到了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "eedebca3-acf7-449b-bc6e-b3d48aa78af6",
        "content": "{\"text\": \"所以它就会断电保护\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5921a7e0-6280-42a0-b38e-e23dee43ec9b",
        "content": "{\"text\": \"朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "752ffc45-83fa-45a0-8c54-8233de93e5cb",
        "content": "{\"text\": \"您想想\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "878e9308-378c-4f93-a983-d21cae927292",
        "content": "{\"text\": \"才七十度上下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b029496a-dc44-430d-b62d-1e45c95df6a3",
        "content": "{\"text\": \"就断电保护了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e100102a-c382-438d-9421-f943b16ba6f2",
        "content": "{\"text\": \"那事故是\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4508209a-6156-47c5-8b92-2a86dbc1f0d3",
        "content": "{\"text\": \"它很弹实\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d3afe7f6-5abe-47ba-9878-fdeceaf75ec5",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
