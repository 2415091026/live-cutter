        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dc071b09-caea-4209-b2af-1d3404780cd5",
        "content": "{\"text\": \"有钻厂给你补贴\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9c005486-a1ee-4449-acb7-208843061fb7",
        "content": "{\"text\": \"还有双式补贴\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "152ffb68-f66d-42df-89cd-d05750bfd0f2",
        "content": "{\"text\": \"加一块剪60多块钱\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b85ab598-e2c3-435a-b2fa-47745c2035d7",
        "content": "{\"text\": \"所以咱们是126\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "08b2bb68-0479-4fdc-94fc-ccbeb8419f13",
        "content": "{\"text\": \"就能造手\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e90f902e-b7dc-4d43-9585-3e3204a6f795",
        "content": "{\"text\": \"相当于给你打了个六折\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1aa68736-7015-430f-a73a-da2b3605e433",
        "content": "{\"text\": \"那朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "72255a61-e0ed-4b21-b2b6-408c9b92eac3",
        "content": "{\"text\": \"然后呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "afe0eee6-a089-4487-8ba8-fc9014870077",
        "content": "{\"text\": \"我们这边给大家推荐一下尺寸\"}",
        "font_size": 8.0,
