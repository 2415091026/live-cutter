    "texts": [
      {
        "id": "8e941fa5-6e29-4e9b-a6c6-666e240c0b37",
        "content": "{\"text\": \"大家下一个福带我们发两机币的最会的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "18e3b421-7909-4711-af65-78e7fe8309ca",
        "content": "{\"text\": \"没问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0d12853d-8a1d-4464-a004-8b6e0c6c2b1a",
        "content": "{\"text\": \"两万多一台了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f798f2f8-98dd-4411-99c9-721da611d078",
        "content": "{\"text\": \"下个福带你先发一台\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d379b737-0beb-434a-9b34-36ed911928be",
        "content": "{\"text\": \"然后再下一个我发两台\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c8ad8caa-898e-4d78-93e7-a49143160242",
        "content": "{\"text\": \"再下一个你发三台\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1e0d2df0-8575-47b9-a151-1ee2fb368ede",
        "content": "{\"text\": \"我发三台\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e7628cce-720b-4c7a-8a0d-8c6e52d8dcd1",
        "content": "{\"text\": \"五台\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b21a3897-1bb9-4566-b507-9a45c3721046",
        "content": "{\"text\": \"一六台起的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1d5f9008-159b-4d4e-a507-ee5e933de76c",
        "content": "{\"text\": \"慢慢来过\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "141a1277-d725-4ac2-aeb4-ccf2023b7707",
        "content": "{\"text\": \"两百台发三台\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "55c88c68-d373-485d-bdf3-a5c1c11c82eb",
        "content": "{\"text\": \"把两百台发完了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8cdac7aa-b689-44c7-b81a-005305460df3",
        "content": "{\"text\": \"想到让我发一台你现在怎么就让我发三台\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "270ffc18-29a8-473b-a2cc-21806d5cc526",
        "content": "{\"text\": \"你自己不愿意发呀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "425d38d7-04cb-4711-beea-1bac0a5e44ae",
        "content": "{\"text\": \"我发三台呀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7648c1ef-f538-4222-b002-669db25c99d1",
        "content": "{\"text\": \"我平时我发三台你让发一台发一台啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fb04d54f-18e3-4a90-97a1-b1f5e73a0100",
        "content": "{\"text\": \"那只能要这么够\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "832ae71f-f76e-4277-b7ea-3067b0903a9d",
        "content": "{\"text\": \"那肯定不能让我发多力啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5d61c490-ecbf-4fcb-aa32-b4f91cd393b1",
        "content": "{\"text\": \"他只要求让他发这三台啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ae59e9e8-78fa-4c3e-9a94-c11b87d5f447",
        "content": "{\"text\": \"我发一台啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f63b1b7a-4f68-4a4f-a6ce-74e9eb155880",
        "content": "{\"text\": \"你发一台\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e2015975-6c30-4714-b074-6fda60e4a5af",
        "content": "{\"text\": \"对啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ad0e5f09-46c2-46cc-b2fa-1feff06aadfe",
        "content": "{\"text\": \"两天一的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3103ae4b-0684-421b-a468-1816d7fcda60",
        "content": "{\"text\": \"那就两天比你嘛\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5f21750b-035a-453a-a050-cb9eae9e421b",
        "content": "{\"text\": \"行\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8c364e83-49ca-4c9a-a586-e924306dfad3",
        "content": "{\"text\": \"我给你发第一台啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "74055dcb-9510-4679-b511-1b4d592817fd",
        "content": "{\"text\": \"OK\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5aef3185-4585-4c87-a2ad-e8a3e8f68e77",
        "content": "{\"text\": \"还不是你发一块\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4ae96f9a-eb50-4b7c-acb1-3ebb980b4b50",
        "content": "{\"text\": \"好半天\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8f8e5240-9a1d-437d-9962-f1e623338919",
        "content": "{\"text\": \"好半天\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "48bab4a6-e943-49c1-9153-07900f475353",
        "content": "{\"text\": \"稍和干啥呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "117d527d-b335-4ffb-9864-d0cb76c726c5",
        "content": "{\"text\": \"干些早点乐子哥啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "aa30a2d9-bfc3-4d83-8710-00ef491b4eaa",
        "content": "{\"text\": \"干些\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1f071e6f-7170-4eea-8a6f-7af2414518af",
        "content": "{\"text\": \"感谢感谢感谢你嘛\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ce1e8dde-c4c8-4272-accd-81257c73fd4d",
        "content": "{\"text\": \"感谢你嘛\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "81c2a663-c20b-432a-90ae-81d63c77c1b2",
        "content": "{\"text\": \"感谢加油小主动\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1795464b-4aaf-469a-8531-2e478e9431fa",
        "content": "{\"text\": \"来给兄们发两个一万的团服我们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c3defc8c-60bc-452e-be70-4fe3dd8e5b31",
        "content": "{\"text\": \"OK\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "94c1d5da-30ed-4814-ac61-f1124c001546",
        "content": "{\"text\": \"点单排的兄弟们参议一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
