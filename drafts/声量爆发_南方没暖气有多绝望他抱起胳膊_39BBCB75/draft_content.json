    "texts": [
      {
        "id": "3812e0d6-d016-465f-9fc4-97e67db9a75f",
        "content": "{\"text\": \"然后又着急\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dfede65f-7f01-4d39-a61d-4e50806991ae",
        "content": "{\"text\": \"哎呀 开公条太飞电的开一火吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e8776aaa-fc32-4a44-b119-3b6138448638",
        "content": "{\"text\": \"哎呀 我这个小太阳更飞电\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a2dc4cd7-203d-4702-ab6d-6b685bf737b9",
        "content": "{\"text\": \"对吧 开一小火吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cf95bd43-e08b-4276-b52c-90601eabaa4f",
        "content": "{\"text\": \"不用猶余了朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e5ab0a14-7937-49a2-9e4b-5e30e265862a",
        "content": "{\"text\": \"咱们今天给大家带来的是我们的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b2aeabbd-34b8-4e2c-a1ca-d8c9ef9edef7",
        "content": "{\"text\": \"电热坦啊朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "28d1e20f-315a-4d02-8a61-80ec1e60bdaf",
        "content": "{\"text\": \"这个是40多年的国货牢品牌\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a869fdf1-79b7-4b98-8c8c-ee105190d475",
        "content": "{\"text\": \"这个叫做彩虹\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c297a974-1f29-4978-bed0-6b0140937471",
        "content": "{\"text\": \"品牌强定人产\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c9871afe-165f-402f-a80a-d6dc89e340eb",
        "content": "{\"text\": \"40多年老品牌\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "86c05ca6-1212-41cd-81e5-ff6983e6897e",
        "content": "{\"text\": \"各位朋友们 如果有用过的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
