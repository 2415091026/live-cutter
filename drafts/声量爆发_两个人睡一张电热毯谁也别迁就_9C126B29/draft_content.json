    "texts": [
      {
        "id": "e2f4b4a2-b9f8-4896-8c0a-2d57397814fc",
        "content": "{\"text\": \"這樣的話你要買雙人款的1.5億米八的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dd95ce74-4d0a-48ad-8ffc-d6a3a2e0e9de",
        "content": "{\"text\": \"就是兩邊都可以分別調溫度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fcb093dc-d98c-49bc-a6b4-70ee2a127464",
        "content": "{\"text\": \"你比如說我左邊想要這個低的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "24cf02d4-5826-4c15-867b-083bb8b79e8a",
        "content": "{\"text\": \"那你要按兩下就變成低的了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dc25261f-87c2-437e-ba82-709ad91325d0",
        "content": "{\"text\": \"再按一下又回到高了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ba2b3549-be49-4832-acf3-197c04890cbf",
        "content": "{\"text\": \"就再按一下就關了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a26acb7f-0ec0-42f8-bdb4-668562cb2d31",
        "content": "{\"text\": \"再按就又循環既然就按私下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "89355ec7-60cb-479c-83c9-f3eaeed1bb29",
        "content": "{\"text\": \"它就能循環\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "26b4b4b7-44c9-4698-bf99-41babd7bda0d",
        "content": "{\"text\": \"然後上面有一個儲滿劑\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
