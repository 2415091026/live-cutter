        "width": 1080,
        "height": 1920
      }
    ],
    "texts": [
      {
        "id": "41b1e8df-1825-4bd2-989d-c6b7f0eeb0eb",
        "content": "{\"text\": \"是舒服朝朝的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6bb11884-76fc-4fa8-b120-b35df2a21e1c",
        "content": "{\"text\": \"所以这种是一种情况\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7ba0f6d6-89c2-4c4b-8c28-c553ec48d657",
        "content": "{\"text\": \"还有就是直接把你握适给你点招了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fdc59f93-ff5b-441b-a0b0-39befcf063f0",
        "content": "{\"text\": \"你多虾人\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d447ebbd-8d39-43e4-84b8-1ad73981a54e",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0685f993-18d2-45c4-aa57-57d477c32719",
        "content": "{\"text\": \"你家有孩子有老人\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "09b348d3-487c-4de5-a5cf-4d1f29562b36",
        "content": "{\"text\": \"你自己设置叫\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "eb0c1695-20af-489c-b55d-b5a6f5a0c753",
        "content": "{\"text\": \"这电池找了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "587474af-93fc-440b-a9df-27f106ae913c",
        "content": "{\"text\": \"然后包括给你考一个这个大空洋\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ec666c01-50ca-4605-8943-46435600f475",
        "content": "{\"text\": \"很虾人的朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bdcfd161-9df1-4635-922c-ab693e091dea",
        "content": "{\"text\": \"所以跟大家讲\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "695825a8-d60c-4e64-9364-f64bca899a8b",
        "content": "{\"text\": \"为什么那些电池谈\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1fc14351-7d41-482e-83bc-33203c6b4be4",
        "content": "{\"text\": \"会出问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f806e032-9e5e-4476-86fd-47aa644bbd42",
        "content": "{\"text\": \"咱们可以来看\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "36872b4a-a674-4155-a4eb-c2e024b10555",
        "content": "{\"text\": \"你看啊朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "31396219-5395-4d4c-9d65-f83435ff2f06",
        "content": "{\"text\": \"那咱们可以看\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c728f413-3238-4903-9899-bafef06ecd0e",
        "content": "{\"text\": \"普通款的电热谈里\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "51b2180d-d2f4-4752-ba68-bb5ea7ccf4c8",
        "content": "{\"text\": \"把那个司日是怎么设计的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "94dade5b-e1af-4cb2-9821-f7fb5fd8538d",
        "content": "{\"text\": \"中间是一个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cd53994a-2ff6-4797-955c-074f870408ae",
        "content": "{\"text\": \"这样的一个融神\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7f77d784-3a8d-4ec8-82bd-6c15580790c6",
        "content": "{\"text\": \"一个神子\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f8bb40fe-0e17-498f-8bee-863d2c0d030c",
        "content": "{\"text\": \"在这个外边的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8c74d75b-dc81-4fac-b2f4-95272d033bdd",
        "content": "{\"text\": \"传繞着螺旋状的传繞的这个发热丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8d455b46-54ab-4d57-8146-cbbdd7256428",
        "content": "{\"text\": \"然后在外边包里层军人享焦\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d0d0d354-0bda-4865-9935-ae6cb70723ca",
        "content": "{\"text\": \"这就是这个传统的设计方式\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "43026116-41c8-4726-932f-f31c11a64505",
        "content": "{\"text\": \"好像问你想看这玩笑的狗安全\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4be24f6a-f2df-42fb-a968-655c4c67f636",
        "content": "{\"text\": \"那吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "07b1585c-b9c9-4372-b719-1ee93f3c7090",
        "content": "{\"text\": \"当年可能没有这个新的思组的时候\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "96eb380f-e75c-4874-a6e7-b62d74ba7742",
        "content": "{\"text\": \"这也就够用了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bc551ef9-a04c-4be0-b7a1-45f399a7695e",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7800de3b-6441-4666-828e-493d6ef8ae5f",
        "content": "{\"text\": \"但是它其实不够安全\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4a7857a1-71a5-4f98-80b3-1e0383de0ae0",
        "content": "{\"text\": \"你想如果这个发热丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4ec10bb8-6404-43cb-bf25-b3f82e8731b1",
        "content": "{\"text\": \"那都是电属丝吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b82b3b56-aa15-4e0d-9eb8-523f840b63e7",
        "content": "{\"text\": \"那温度过高了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "482d59c9-3106-498f-b341-6dfdb9c9ba1c",
        "content": "{\"text\": \"或者鸡载的温度过高了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "aa9cd4c8-991c-4cd2-a083-2054261796e1",
        "content": "{\"text\": \"是不是这外层相交容易化的呀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d46fbe23-4a32-48d1-910f-11e148e57eab",
        "content": "{\"text\": \"这外层相交容易融化\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "37fa9b4c-3047-42b8-ab53-662f41c16cc5",
        "content": "{\"text\": \"是不是就很有可能会变着\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cb52f269-cadc-4071-b4b8-13348f18839d",
        "content": "{\"text\": \"你家里边的一些线位的东西\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bd3bfc20-2017-48a1-aa70-badc482cd60e",
        "content": "{\"text\": \"就一发火灾了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5fe193af-6d73-458c-a959-fafbd84f4ab8",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ad3f993f-34f7-4de1-853e-742895451ca4",
        "content": "{\"text\": \"原理其实就这么着\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a1c81642-a1c3-4ab7-b254-0ede22babcfa",
        "content": "{\"text\": \"但是您可以看下咱彩红做了什么\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
