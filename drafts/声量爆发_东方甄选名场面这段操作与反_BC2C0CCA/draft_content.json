    ],
    "texts": [
      {
        "id": "fbdb4411-0eb2-4e7b-9e8c-f913b2daf425",
        "content": "{\"text\": \"其实把我证明有保障了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "56937c47-e380-4f66-a045-42a778e17127",
        "content": "{\"text\": \"再详终一下我们今天的下午\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d03fd0f5-8d43-4745-a102-caeefc9cf2e7",
        "content": "{\"text\": \"因为是感觉双齐一了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "622c40e9-09ad-425d-8765-9968c6e99cad",
        "content": "{\"text\": \"再加上来到彩虹\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "31c25b62-1bfc-49c2-8ca4-60f9238b16b8",
        "content": "{\"text\": \"就不给了个位上的速度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "548eda96-2ca1-4795-9007-38d8029ef397",
        "content": "{\"text\": \"再来一说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9a6b8ec0-2bc5-47ea-96b0-20d698f8c8d9",
        "content": "{\"text\": \"每天一单单\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e77dd00b-9a41-4787-af19-4c2c157864e7",
        "content": "{\"text\": \"那60多块钱\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "63312c84-8d70-4808-a0d9-12f6ca99b80a",
        "content": "{\"text\": \"但是那十分四点三号\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "298de8c0-858e-49f2-bf16-3b732f24b2f8",
        "content": "{\"text\": \"来上到女的小三百万\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "211043e8-d580-4b47-9837-668ea1739838",
        "content": "{\"text\": \"一分几天净确了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "375ffad1-f21c-44ff-9117-669ecc53cb16",
        "content": "{\"text\": \"我天净的真的没有那么多\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f367a908-e4e6-4a62-9cda-3ceb2bfc5b21",
        "content": "{\"text\": \"而且我们这一概\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a07dee50-aff3-44f8-8930-addd7fa4acc1",
        "content": "{\"text\": \"又是双齐一的价格\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ce83d5d1-0b7c-423a-92c8-1e44c6ef0c1a",
        "content": "{\"text\": \"大家可以知道\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ec6aa25b-c849-447f-9ad7-e54526bae40d",
        "content": "{\"text\": \"双齐一一\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e5f9469a-3a35-415a-8509-78cc706dae2d",
        "content": "{\"text\": \"还是在这边让国士的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2fb75193-5b15-4fab-863e-f1fd6cf695a8",
        "content": "{\"text\": \"比如聊天懂\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "38629962-eb27-4d00-bda0-13aeb8aa7ecb",
        "content": "{\"text\": \"我们今天是给你做到了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "71d07250-2db3-44ff-a4d4-219e5db35207",
        "content": "{\"text\": \"保障全年\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6502e270-dcff-4483-b9ac-9444d809d214",
        "content": "{\"text\": \"都不在后面的双章\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "07722ec7-efe0-4840-9ac6-d157f17ce38f",
        "content": "{\"text\": \"双齐一\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
