    "texts": [
      {
        "id": "d7f90494-ebad-44bb-ab32-00a02cd740a5",
        "content": "{\"text\": \"而今兒發作品說是無盡派的扔扔了的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3951a10a-590f-4aed-8f2d-9b425a0e4d26",
        "content": "{\"text\": \"今兒發作品讓無盡大家去\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "efe311f2-d5f0-43d3-b4fc-214b06fe626c",
        "content": "{\"text\": \"對舉報無盡對的他俩是一直繞著\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7acab123-1daf-4e61-9afa-d15d169315c8",
        "content": "{\"text\": \"反正就是挺容易的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a3c72d82-62b5-4dca-9419-62ad540a192e",
        "content": "{\"text\": \"當我拉棄的拉棄的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "46baa249-3f05-4764-8ef8-38132a70ed62",
        "content": "{\"text\": \"張大龍來了嗎\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2f00abd8-6e5e-45ba-a729-92d414ffdd68",
        "content": "{\"text\": \"張大龍沒去張大龍\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d89e0327-c97a-49ad-b158-9f28ba199a03",
        "content": "{\"text\": \"他寫不可那個廣州副朝廠辦人的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
