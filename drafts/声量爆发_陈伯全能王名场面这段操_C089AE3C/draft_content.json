    "texts": [
      {
        "id": "7347cd28-6b3e-474b-9693-665224f06f2e",
        "content": "{\"text\": \"直接上恐懼瘋\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6bc59e04-6807-4ff8-a37b-6c2145783972",
        "content": "{\"text\": \"直接上恐懼瘋\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e79a8b19-9b38-4b45-b0cc-e996a38d7c82",
        "content": "{\"text\": \"主要叫复代宣门\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "67117790-7622-47bf-8792-16eea00ef424",
        "content": "{\"text\": \"電關處拿走一台蘋果是吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "98e8cd3e-e86a-45dc-b535-9c3f74edfc1c",
        "content": "{\"text\": \"沒兩關處中了講的時候都沒有了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a7a05b5e-2d40-46e8-8cee-d1e944017d71",
        "content": "{\"text\": \"而且我們免費的關注點一個\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0aa307fc-b8a8-4938-b75e-78542af3201b",
        "content": "{\"text\": \"我對面直接上大將的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d5f2e555-efd5-47a3-a07d-53f9c0b7514e",
        "content": "{\"text\": \"四大金燈之一\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "74a7bf21-a570-4ccf-841f-c9cae430ab3b",
        "content": "{\"text\": \"你也是我們四大金燈之一\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "739fc753-5cca-4afd-bf9b-b9816a6cfcae",
        "content": "{\"text\": \"不要徐豪嗎\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "322250d1-3406-4422-9f6d-261ddf9419dc",
        "content": "{\"text\": \"加油\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e6deb767-a57d-41e9-b711-c1b222801cca",
        "content": "{\"text\": \"海冰這眼\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "617295bc-7d23-45f3-90e3-cd056ab0abb7",
        "content": "{\"text\": \"海冰這眼第一張不是水出來的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7f72a45f-1061-4309-b87d-bf715525f2b0",
        "content": "{\"text\": \"而且我們還沒有選過\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "69dff20d-abdc-4eba-a69d-a6e52e6bdeab",
        "content": "{\"text\": \"加油\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "82d3341f-facb-4dac-bab1-7fcb7e631c7d",
        "content": "{\"text\": \"回來了一萬人聰明\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a9a406f9-ae2c-4a53-96ab-bb403742655b",
        "content": "{\"text\": \"再把三個一萬人傳送了嗎\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
