      },
      {
        "id": "304e347a-293b-4dcf-a707-e3d65a15a0a7",
        "content": "{\"text\": \"好\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0fc51a5a-526b-4878-8918-adf4c0985870",
        "content": "{\"text\": \"我来说的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ef181616-a467-4145-b52e-e672798e4636",
        "content": "{\"text\": \"今天我发开听过说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dd048a10-7be7-41e5-9b50-d65d73e8d5f4",
        "content": "{\"text\": \"听过是巴普洞\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "26c9f93f-627f-4d04-ab05-9200e9177c05",
        "content": "{\"text\": \"闻住\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a7a8947d-6eb5-48af-8d3d-ec47665ec361",
        "content": "{\"text\": \"给他发布\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ced0f761-3b88-4118-8194-9349eb8b1386",
        "content": "{\"text\": \"看他选什么头\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9370dc27-952e-402a-a60a-c9df782d0738",
        "content": "{\"text\": \"站他命必须给他吃掉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "25238587-d079-4794-96a2-53dd8bb6a82e",
        "content": "{\"text\": \"有没有压力\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "eb7752d7-d544-489f-b28f-88164ffd91f5",
        "content": "{\"text\": \"没有\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3d3dff15-9b4f-468e-81e4-40d5be969942",
        "content": "{\"text\": \"必须给他吃掉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d97942be-88e6-41fe-b962-0dda3af8a57f",
        "content": "{\"text\": \"老闆的老闆在旁边\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dbc5d787-e66e-4f70-986e-b1e032116f5c",
        "content": "{\"text\": \"这生了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ce5261cf-f9f5-4ef9-ba57-51c5f1d0102b",
        "content": "{\"text\": \"起书列车不要怕\"}",
        "font_size": 8.0,
