  "materials": {
    "videos": [
      {
        "id": "1dfaaddf-8e60-4528-9317-463ea864ca9d",
        "path": "E:\\代码\\美食街\\live-cutter\\recordings\\21-13-17_东方甄选_p042.mp4",
        "type": "video",
        "duration": 3600000000,
        "width": 1080,
        "height": 1920
      }
    ],
    "texts": [
      {
        "id": "0254b078-53db-4602-b27a-6d5eea35ac2f",
        "content": "{\"text\": \"所以大家如果平时要用电子弹\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "aaa4b455-5d5b-4527-bbeb-5bacbd705cec",
        "content": "{\"text\": \"有点担心有点不踏实\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "434eabf0-7da0-4cf1-b193-aa47adfe56f5",
        "content": "{\"text\": \"不就是因为电子弹老出事吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "027057aa-eb96-4af0-b3a2-55ed5b67cea2",
        "content": "{\"text\": \"是不是\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c32484ba-196a-4851-bb2b-32372f9acbab",
        "content": "{\"text\": \"那我们告大家电子弹到底是怎么回事\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6fb43a12-52aa-4316-8ca1-3c9f4103cdca",
        "content": "{\"text\": \"你看像今年广西老大也气是多岁了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e951c94f-ac75-42fa-92ec-a9cfbca04336",
        "content": "{\"text\": \"电子弹招了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "388f0d61-19a7-4a4e-9dd7-c81b57570e51",
        "content": "{\"text\": \"当然跟年龄没关系\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4f3f66f1-62c8-4880-9c6b-0949b5a9e913",
        "content": "{\"text\": \"然后这个小哥哥的家里养了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9dca23e2-d267-410e-8269-17e9d0a75aef",
        "content": "{\"text\": \"还是一起\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3bd152c6-0f25-4b7e-a389-1a7a2bcd9c29",
        "content": "{\"text\": \"还是一起翻译把他脑醒了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9baee8a4-4428-4781-a4c3-8722f35516f0",
        "content": "{\"text\": \"电子弹猫烟了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3b9f34a9-6eb7-4058-a331-50c0b2bb27c7",
        "content": "{\"text\": \"还要像直接\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5dacb824-5da2-4d50-979f-5dc5c7d36bcf",
        "content": "{\"text\": \"这个应该是妈妈吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6712f6e9-4413-42a2-b670-e248f7808d92",
        "content": "{\"text\": \"我试直接招火了个位\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "88a4f98b-b6ef-48ed-b3bd-37b0a7822a0c",
        "content": "{\"text\": \"虾人多虾人\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6b8f79be-5c36-47c0-b086-2ae162fe19d9",
        "content": "{\"text\": \"你这孩子要跟着睡觉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cecd12f7-1d31-4680-9c80-d76e3db0399d",
        "content": "{\"text\": \"我天老人家睡觉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "acb48c52-0ef8-4dc7-99c7-a5faff1b3235",
        "content": "{\"text\": \"你自己跟着睡觉叫招火了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "584efbdd-07e1-4f00-884a-8982531d19da",
        "content": "{\"text\": \"然后还要给床考一个打酷弄的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d613fb19-1439-4626-902c-cffe0b51248f",
        "content": "{\"text\": \"真的挺恐怖的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e37c52fd-651e-46f1-8402-0a72e30d9219",
        "content": "{\"text\": \"所以为什么会有一些电子弹出现问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "97d5adbb-2192-4378-858d-248ee5c59d7a",
        "content": "{\"text\": \"我们给大家\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8df46429-6a8f-4b84-afae-909ffaecd2a4",
        "content": "{\"text\": \"真的能特别简单地给你抛弃干净\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "49c34272-bd85-47d1-a100-59a74ab0eb81",
        "content": "{\"text\": \"抛弃的进入民伦外外的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9b86881e-bf7f-40db-8e31-3711d1252844",
        "content": "{\"text\": \"来听一下朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9aae2121-b452-4e3c-851b-91daa58eab78",
        "content": "{\"text\": \"你看普通的电热弹\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3a052f51-c5be-4f14-98a1-9d047b48f33b",
        "content": "{\"text\": \"里边那个私事怎么设计的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2ad77061-80a1-4b7b-9bae-90e3f545d8e9",
        "content": "{\"text\": \"中间是一股神\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "71e39b18-4a95-4e18-bba3-466426d930d3",
        "content": "{\"text\": \"中间一股神\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cee7949d-019b-4fdc-97fa-b4b97d23e818",
        "content": "{\"text\": \"然后外边的传绕着这一层发热丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "546c0b55-577a-472d-9dfe-ea6e0948ebcb",
        "content": "{\"text\": \"然后在外边包一层这样的这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b66abe3f-a269-45eb-ab75-d8bf42a544ab",
        "content": "{\"text\": \"绝对想交\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "727b5d3e-1c27-4512-975e-ec3f095287aa",
        "content": "{\"text\": \"就是这么三层\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a941ce71-14f9-4f85-8112-145268acf186",
        "content": "{\"text\": \"那你想想\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "47ab4195-c9f8-451e-bae6-15703fa65c3e",
        "content": "{\"text\": \"如果是这样的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
