      }
    ],
    "texts": [
      {
        "id": "ed694022-e076-4a25-89c7-8e95d0efd4d4",
        "content": "{\"text\": \"柔度呢,我们家现在这边还干嘛还穿短袖呢?\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3a3bbb21-8f46-49be-83ed-2cdfc13a57d6",
        "content": "{\"text\": \"我就不信你那边一直不冷,除非很难,\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ed0297cf-4159-4f44-b4c4-3e038c38cb86",
        "content": "{\"text\": \"行了,你不信一直不冷,是不是?\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a93cf7db-acbb-4799-893d-a14ea27a7042",
        "content": "{\"text\": \"所以的话,咱们没必要说让自己那个刀真的冷起来了,\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4a27dc94-e2d4-4e9e-974c-56f0d7eb7095",
        "content": "{\"text\": \"然后再来买,这机制可就没了,\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a5464fdb-2ed6-4b9c-b552-8765e0f3f597",
        "content": "{\"text\": \"而且外家就说,你现在买那笔,\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5466c344-3520-4548-a8e2-920744ef41c7",
        "content": "{\"text\": \"比过这过回时候再买可能能便几十块钱,\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "26fd59f5-0e60-449c-8cf7-897a276f7e59",
        "content": "{\"text\": \"咱干嘛不现在买,对不对?\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dbfbe5b1-4f13-42d8-b5da-83e859fe7539",
        "content": "{\"text\": \"而且的话,如果已经冷起来的话,\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
