    "texts": [
      {
        "id": "72022ad0-c1fe-4b2e-9e61-ec158d10950f",
        "content": "{\"text\": \"知道摩念他们了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4a596249-da93-4c92-b999-228e5b197351",
        "content": "{\"text\": \"好 这随意玩一玩就行\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ae6a0187-9e07-4d46-aa09-3a95e465ec5f",
        "content": "{\"text\": \"来吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ea75f22d-f159-4973-9b54-040390679bd0",
        "content": "{\"text\": \"李克节他们开播没有\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c657db24-477f-4362-81fe-dbacd28e872d",
        "content": "{\"text\": \"看看来\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "94a38841-16fa-4292-958b-f4113d9ae59d",
        "content": "{\"text\": \"开了这些海码\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "77ac2c71-b369-4fe9-a4ac-537612f20681",
        "content": "{\"text\": \"海码今天发烧了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7c870edc-d145-482e-a63d-992d94b4995d",
        "content": "{\"text\": \"海码发烧了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f7838ea3-063d-4f34-b903-3fb4d2f1ec84",
        "content": "{\"text\": \"生病了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ee58654d-f354-46b9-8915-0e4d92aa8c57",
        "content": "{\"text\": \"他请假一天\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "baaf6753-844f-46cb-8845-c05de6a91676",
        "content": "{\"text\": \"对 可能是有四个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0ca3aca7-5a20-4439-9825-cfc6c841774f",
        "content": "{\"text\": \"其实我们现在给了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1b98e431-b327-4e5d-a647-a4dd44e008f7",
        "content": "{\"text\": \"你看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a562662e-637c-4a07-bf98-97ef0c4e6c81",
        "content": "{\"text\": \"一片片都没有\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c9733b2f-52ab-46d4-b613-d51187c93363",
        "content": "{\"text\": \"他过程要了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e2d78057-c4e8-4bab-877c-212dc8558ca7",
        "content": "{\"text\": \"我们就不会再开了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "24990a2e-1754-4f30-ad36-2714ddc3d579",
        "content": "{\"text\": \"他请得并假呀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "51e9eb35-7c0a-4eb0-ab26-938aa50ffe38",
        "content": "{\"text\": \"他说不得真想\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0f51738b-7971-43b7-878a-37323194304e",
        "content": "{\"text\": \"他说不得\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e0f2d898-0f93-4f14-b1ce-9f8786e0cb8c",
        "content": "{\"text\": \"他说不得就并假嘛\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5cb49758-8a85-4ec7-ba88-977acf3fac46",
        "content": "{\"text\": \"对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cd52df89-c3f1-49b7-8f3d-6211af14f3a4",
        "content": "{\"text\": \"一天看很多事\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "166c2307-4990-49fa-a877-3712596b1012",
        "content": "{\"text\": \"是第\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "31d4892f-0aa1-4695-a8c2-c240d2f7ea2f",
        "content": "{\"text\": \"什么意思\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dac45496-eb9d-4e14-87a6-0bd1a14ec7cb",
        "content": "{\"text\": \"他打个洗理箱\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "05e4bb8d-9337-44b2-a865-1fe3f07db80f",
        "content": "{\"text\": \"打个事都不知道\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0ecf9752-187d-4865-9f2c-f17ad6e56f0e",
        "content": "{\"text\": \"对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a6c7439a-4973-4c14-9c30-ef057c860506",
        "content": "{\"text\": \"真的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f78d36e9-059b-415f-b172-670ae97a001c",
        "content": "{\"text\": \"还这么拿的洗理箱了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b3705a1f-b3d6-4b85-8f98-2a17adf45747",
        "content": "{\"text\": \"对啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "164e4654-dfe4-45ad-92d9-5c4bd4f7a321",
        "content": "{\"text\": \"真的吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3bcdb13a-e3ca-45fd-a6c8-3f1d1ec8993e",
        "content": "{\"text\": \"你确定没有\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1e04ab1d-90dd-4df7-b44c-4006da09a656",
        "content": "{\"text\": \"我确定\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "143cf2fb-c7a4-4711-9432-a613fd5a6733",
        "content": "{\"text\": \"阳村村卖有个在开播\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "449d1cbc-829c-40ec-9837-5c32640b578a",
        "content": "{\"text\": \"对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "af7abcad-2150-4eca-a9f6-3912a982989c",
        "content": "{\"text\": \"好 没开播就快适人\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "39e837b3-f37f-4275-87ec-fe8a02c418f7",
        "content": "{\"text\": \"他在开播\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2c89f828-79bd-4296-b546-1e5f35ce3d65",
        "content": "{\"text\": \"在\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a4ff9e58-7a81-4a23-a471-ba0d0e8733f2",
        "content": "{\"text\": \"妈妈的心里来个外鞋\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b7f95d8b-27af-4961-91fb-ded90bc53cb4",
        "content": "{\"text\": \"我一躲着你\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "559abc37-9e32-4365-93f8-419f6df9e256",
        "content": "{\"text\": \"还马上去重新了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c872b00e-3947-46d6-ba3b-9dd35b71e67f",
        "content": "{\"text\": \"你结果播了早上的下播\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d11d0d62-7506-40cc-b930-ef9eb96eea9e",
        "content": "{\"text\": \"还马上先请名价了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c6ed0759-4012-4ca2-8124-8c16818dd593",
        "content": "{\"text\": \"他们说是他去重新了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "54a3a89f-087b-4862-a989-6a3c2a003a2f",
        "content": "{\"text\": \"什么意思\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f26324f6-5ea2-4ce0-86ed-7a3ece5a0fa7",
        "content": "{\"text\": \"我不知道\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "664142db-1ba1-421e-946f-7f6aed8f462d",
        "content": "{\"text\": \"他没跟我讲\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fffc8a1c-c12f-4b2b-8928-c1edbfb8250a",
        "content": "{\"text\": \"没讲\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0b2f0623-d5d7-4f2c-b4a2-78c3e646ebaf",
        "content": "{\"text\": \"给一个机器\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "775276a4-d7da-479a-bf08-029083263ac0",
        "content": "{\"text\": \"你确定\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dda2aeb8-66aa-463b-b321-96baff634c1b",
        "content": "{\"text\": \"那我以为就下播吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5a054f69-7b8e-4dab-a7b4-78c96e460c90",
        "content": "{\"text\": \"我下播了兄弟们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
