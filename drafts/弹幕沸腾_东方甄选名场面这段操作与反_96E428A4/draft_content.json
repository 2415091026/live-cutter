    "texts": [
      {
        "id": "09c45072-8855-4e59-aa15-fe579f8a10c6",
        "content": "{\"text\": \"別人跑步才登出去的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "269fcbdc-9e47-4e2c-ad9d-24986a4007f2",
        "content": "{\"text\": \"我們跑步才砍出去的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "031be467-be63-459a-876d-8d76abb882de",
        "content": "{\"text\": \"就站不酸小就站\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1c00eede-2956-469a-a5c9-bd3ee08ad76d",
        "content": "{\"text\": \"你也不累掉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e3ac60db-0f26-46e5-ba07-2d8632d8b49d",
        "content": "{\"text\": \"既有聯席的保暖\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "504059e2-5222-4da2-944d-f43243b42eb4",
        "content": "{\"text\": \"又有跑歇這個糟糕\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ff99df53-462e-47c0-9e8e-4133ea754d34",
        "content": "{\"text\": \"這就是我們的一號零件\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e9297dc6-c4e3-4e58-910b-5211efc9b9f9",
        "content": "{\"text\": \"是的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d45a35ed-ec63-420b-9da8-27c3044e5dde",
        "content": "{\"text\": \"評論訊號各位\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0ad02c81-b919-4c2c-98b4-179a26f3c209",
        "content": "{\"text\": \"有多少想要什麼吃碼的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "48bc2a0a-a541-445c-bfee-d3e36da53443",
        "content": "{\"text\": \"辛苦能可以吃的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c27efb90-8ef9-4f57-8113-2ac2f05aea47",
        "content": "{\"text\": \"評論訊領男女通管\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "06f1d2f0-991f-44ea-a564-5bec52b7a985",
        "content": "{\"text\": \"想要什麼吃碼\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8ea02560-1a2c-47d2-8761-0eae4b64780d",
        "content": "{\"text\": \"打在評論訊領領領領領領領領\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2a9e41a3-301b-4546-981a-4380caec7edc",
        "content": "{\"text\": \"但我們三八都還沒了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6ea4a291-1934-48ae-997e-e87ae749a2ac",
        "content": "{\"text\": \"三八的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cd654d05-c26c-4bc9-8f06-554ed2dce844",
        "content": "{\"text\": \"三八的和四二都還沒了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "47528ff7-27c8-4947-8b6e-0d03b698ce99",
        "content": "{\"text\": \"這兩個吃碼的不用敲了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "13d37ef7-f1e4-4a93-9c78-835b5be42733",
        "content": "{\"text\": \"如果說有\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "821a93e6-6127-4eb3-96d3-31e61411fc9c",
        "content": "{\"text\": \"您在覆換\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "019ce8c8-45b5-4351-acf6-2a1c152f2e1b",
        "content": "{\"text\": \"如果沒有也實在抱歉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f1d16c68-ced1-493d-ac8a-ccdd2e9f7a7c",
        "content": "{\"text\": \"證碼準備看完拍大\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e0bdba25-4d77-4d6c-927d-402b51e7f6c6",
        "content": "{\"text\": \"假融的也正蠻正拍\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4d9e4800-ed0c-41ca-80b1-fa1f1073025f",
        "content": "{\"text\": \"再來給你看眼價多\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a1b71488-8de4-4eb9-812b-05fd6a3220fe",
        "content": "{\"text\": \"正常現下您買多少錢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "83704af4-a012-4c85-ad06-a70ae4de74ee",
