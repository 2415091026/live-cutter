  "materials": {
    "videos": [
      {
        "id": "b77b73ae-d339-48f7-ad13-44e0e8b4e269",
        "path": "E:\\代码\\美食街\\live-cutter\\recordings\\21-11-53_东方甄选_p041.mp4",
        "type": "video",
        "duration": 3600000000,
        "width": 1080,
        "height": 1920
      }
    ],
    "texts": [
      {
        "id": "02c2257b-3470-444d-8e5e-8242d5601e9f",
        "content": "{\"text\": \"不是船那么一点点钱的对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "31c9d079-7daa-40e3-aad5-b076ac8d713b",
        "content": "{\"text\": \"没必要让自己在江舟了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6c20b5f2-99d6-4786-aa18-2e73e3bf1731",
        "content": "{\"text\": \"而且家里面女生我们家有空调\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "eca474e5-7d07-44f3-89c5-79c4d8df6855",
        "content": "{\"text\": \"我们家有气脚线\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b3813c04-3fc9-4b2d-ab20-1414192f4aaf",
        "content": "{\"text\": \"我们家有什么这个小太阳\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9e1224fd-3f39-41c7-9769-57942d5c88e3",
        "content": "{\"text\": \"但他有一个设计就不了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ac99723f-0715-44b8-a2f8-d164f078f5e1",
        "content": "{\"text\": \"低脚线大家长条的那种\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "17d31141-9448-4146-b441-12612f968237",
        "content": "{\"text\": \"你放这边你这边人怎么办\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ca6d458b-127c-464e-b3d8-b9452bcf3e2b",
        "content": "{\"text\": \"你放这边这边人怎么办\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "78534792-8217-4b31-b062-7aa729bc80db",
        "content": "{\"text\": \"别小太阳\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f45c439c-cbb9-4697-9ed4-3b7b96d07148",
        "content": "{\"text\": \"你家里不能跟一堆小太阳考着你吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9a961628-2137-4444-8c29-a1c518e53707",
        "content": "{\"text\": \"对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dde71cf2-edb7-4606-a19b-c68306df0afe",
        "content": "{\"text\": \"那武力得多造热呀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8f6ddb83-88bf-4ba8-a3d9-9971ca24f956",
        "content": "{\"text\": \"所以这样的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ab427c15-a51f-4cdd-93b8-585b2aa86747",
        "content": "{\"text\": \"他也是只能举部空调的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2cd696ed-d97d-4655-855a-fcd4ccb814a2",
        "content": "{\"text\": \"也是能让物力般暖化\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "11d4c7fe-0673-4290-bd12-7e0bd69de55b",
        "content": "{\"text\": \"以上这些都是让你的背屋\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0c3476fe-f03d-452c-aa70-0f732ca8a815",
        "content": "{\"text\": \"如果游戏南方地区\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "182ae15c-d796-43e5-b8c0-4aa07ed60c58",
        "content": "{\"text\": \"朝食那把朝楼那阴楼\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "86251189-d0db-4c6b-8f70-de3026755732",
        "content": "{\"text\": \"改变哪把朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "19a37692-e59f-4fbe-9be9-4e6e8d1a3f54",
        "content": "{\"text\": \"没办法吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8de64f19-1194-42aa-a74a-6ca0da9e85e3",
        "content": "{\"text\": \"所以的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c846bc1b-54cb-44d7-8adb-a31104e7885b",
        "content": "{\"text\": \"咱们今天跟大家说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "54b19b3d-e209-4b1c-bd6c-04e6d698c33c",
        "content": "{\"text\": \"为了原本睡觉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "41818a13-b27d-44a5-906f-b371fb21f319",
        "content": "{\"text\": \"应该是一个很舒服的事\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3802951c-e3dd-4fe1-af61-fd632d7197c5",
        "content": "{\"text\": \"冬天尊热背屋\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b8147416-9e14-488a-b91b-486b1098b4ba",
        "content": "{\"text\": \"朋友们听见就多舒服\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8006b9fa-3aed-4812-ba42-b8b374528e0c",
        "content": "{\"text\": \"但是事实上是\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2599fce8-597c-4a45-b55a-94409230e22a",
        "content": "{\"text\": \"尤其冬天在南方尊背屋\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bdf81211-19a8-47eb-bbbf-db1925efba41",
        "content": "{\"text\": \"是个很痛苦的事\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a8a51e5c-390c-4696-95b2-a8beab613c83",
        "content": "{\"text\": \"因为我们最近已经出差\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b5438799-f58f-4b7a-ae2b-634b38d88eb0",
        "content": "{\"text\": \"冬天也没少去南方\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "eae0a842-4e8a-47f1-8303-59279df42d93",
        "content": "{\"text\": \"他确实是\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a1f56e25-abdb-4416-91d3-9ee45fde2c2d",
        "content": "{\"text\": \"那背在你摸着\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5de7963f-3460-4fe2-9a06-5ff9dec2d80f",
        "content": "{\"text\": \"真的感觉两艘艺的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d821a6a1-2887-4959-adce-777bfeae3332",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d40cbd92-890f-475b-adbe-6509130773eb",
        "content": "{\"text\": \"就是朝呼呼那样\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
