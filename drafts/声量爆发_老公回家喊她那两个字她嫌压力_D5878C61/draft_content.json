    "texts": [
      {
        "id": "3a1639b8-fb07-4587-ba57-eac1883f60a1",
        "content": "{\"text\": \"他的问题就是他\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6ce2969c-b8cd-4713-8949-dd41c8ab191b",
        "content": "{\"text\": \"他觉得他的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "76966b51-cfd8-48e6-bb05-768586515201",
        "content": "{\"text\": \"他和他经营一理婚姻的时候\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "99bde957-fa7e-4571-845e-616f60e5680d",
        "content": "{\"text\": \"他老公每次回来说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "289482e5-072a-4f61-b130-cc27cfbba892",
        "content": "{\"text\": \"叫我平凡\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5c30f8dd-b51d-4e4c-a57f-8e8e532ed164",
        "content": "{\"text\": \"然后他感受到很大的压力和不适感\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7977e4a1-035e-43b1-82d2-e0de263583c0",
        "content": "{\"text\": \"解门说的是实话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "11e16116-8643-4fef-885a-46abf0b7b1b8",
        "content": "{\"text\": \"这是一件幸运的事了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7b8eb734-6c71-4a6a-b99a-cd7bec62e0b8",
        "content": "{\"text\": \"如果他回来之后\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "57d5b359-d2ce-4201-b991-99a85a2d34dc",
        "content": "{\"text\": \"对这东西\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6743697e-bd76-48fc-b081-17bbf4fb9766",
        "content": "{\"text\": \"其实并不感冒的情况\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "46143d1f-643e-4b4d-aa11-9c8fe4a9732e",
        "content": "{\"text\": \"反而说明他在外面可能吃了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b2f06e09-033c-4d47-b449-a24fed06687e",
        "content": "{\"text\": \"可能吃饱了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
