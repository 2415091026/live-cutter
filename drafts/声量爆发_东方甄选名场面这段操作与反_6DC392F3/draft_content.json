      }
    ],
    "texts": [
      {
        "id": "eba6d8d3-2ff2-45f4-90d6-e3a25dbecf55",
        "content": "{\"text\": \"看他吧 这是一个朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "69a3dc8d-d439-4a88-a083-46baaf305aeb",
        "content": "{\"text\": \"党位都可以调的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c307fc9b-dfa6-4bd8-a667-66344d1ca1e3",
        "content": "{\"text\": \"然后他现在也是热热护的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fb2acaeb-8fef-4fbd-92b2-bf69380e75f7",
        "content": "{\"text\": \"我们把他放到水里面\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2250439c-e9f5-41fe-af29-ced4ad9b622d",
        "content": "{\"text\": \"各位看\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "efe6ceff-4c39-407c-9005-8dc42932c924",
        "content": "{\"text\": \"我现在干脑我的手身到水里边去\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8e3e7910-01a3-4e70-b0fd-c5494f5ef425",
        "content": "{\"text\": \"你想想\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "65aae6ef-e2fb-405b-9624-7222c66f936c",
        "content": "{\"text\": \"电热坦放水里泡\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d0e5468b-f3e9-4a8c-a30d-d2b2818aa5d6",
        "content": "{\"text\": \"然后这人\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fa68fb5e-90f7-42c2-924d-cb37fd80b25c",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f112ab1b-4505-4f11-b277-769dd0cb8607",
        "content": "{\"text\": \"这人干脑手身到水里朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7d3fc851-7738-425e-be06-a7da781f04ba",
        "content": "{\"text\": \"你可以想象这感觉 对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8c72f150-c312-4aba-a352-d843cbcf2ae8",
        "content": "{\"text\": \"水和电加一块\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1591f7d0-3c72-433d-906d-9f41f7a3bbdb",
        "content": "{\"text\": \"是不是听着就很下人\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "32cf8c8a-0060-458d-a183-4342df8ce766",
        "content": "{\"text\": \"但是咱这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f920e91e-485b-4628-8331-a01462953d49",
        "content": "{\"text\": \"没有问题朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "40c6f7c9-0b79-4abd-8bf4-d0e51355cdc1",
        "content": "{\"text\": \"真的很踏实\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "35ba9c2c-63ee-4f3b-a22d-dd08a0e11c43",
        "content": "{\"text\": \"而且我们今天价格还特别的好\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2a0c3c14-69b2-485f-9128-590b7f93ceda",
        "content": "{\"text\": \"各位可以看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a0e5b1df-7ac7-47a2-8315-a1978e089048",
        "content": "{\"text\": \"咱们今天价格\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6c16957e-6dee-410f-ada2-a59e39b54338",
        "content": "{\"text\": \"有多合适啊朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "259e95dc-6b33-46fe-b579-19c535ee341e",
        "content": "{\"text\": \"来 给大家看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9ce7e5f7-f421-4e23-974a-37fd8da59781",
        "content": "{\"text\": \"一名舞音是特别主流的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9bd37f27-7592-4316-a3aa-c98366c28b8b",
        "content": "{\"text\": \"这个双上床的那种一个款式\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c0f406fb-7264-4837-878a-69af22413925",
        "content": "{\"text\": \"来给大家看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "28128db5-4f37-41d9-aeb7-c4ef623b3738",
        "content": "{\"text\": \"日常的话咱们这个是要卖到\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "da53f8d8-69c9-4b4a-901b-7da704840362",
        "content": "{\"text\": \"一百八十九的价格\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e4eb65b3-fc38-4629-abf8-ba5b47db562f",
        "content": "{\"text\": \"就现在一名舞的那个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "37ca6cd0-4ab6-4e59-ab30-723a875aa4e8",
        "content": "{\"text\": \"要卖一百八十九\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bb26c6d3-5abc-47bd-be7c-7a57fcaece4b",
        "content": "{\"text\": \"然后咱们今天这个的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5d2ca18a-6bb4-40e6-920a-d412f32bff10",
        "content": "{\"text\": \"因为感觉双十一嘛\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8cead66c-2316-4a58-9da6-48d957777c13",
        "content": "{\"text\": \"你就真别等朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ccbbf1f7-4a2c-494b-8f85-58f231b4db3f",
        "content": "{\"text\": \"双十一肯定比网长\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dc5deb40-3140-4f67-b8bb-3455c4ee7e7a",
        "content": "{\"text\": \"打折力度要更很一些\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "58077b7a-816e-4e5b-88be-af8f0501f0b9",
        "content": "{\"text\": \"更猛一些\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0d55e0b1-fa71-419a-b9a0-184338cead4d",
        "content": "{\"text\": \"先给大家剪三、三\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6c0ca9b7-d3e0-46ef-a756-4546047a5cec",
        "content": "{\"text\": \"专场的补贴三十\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a3e354dc-318a-4c5e-a163-b64dfdb618e1",
        "content": "{\"text\": \"这样的话剪六十多块钱\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5382b487-f811-48e1-b144-acdb74d1956e",
        "content": "{\"text\": \"一百二十九\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "895680cf-e103-42e3-bb00-cec8b6afa921",
        "content": "{\"text\": \"那还不一百二六\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5b2bcfbf-f13f-4dc2-881f-643ea44755b7",
        "content": "{\"text\": \"相当于打了个六折朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9fa9ca80-9ec7-447c-936b-f92df4de4347",
        "content": "{\"text\": \"特别\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
