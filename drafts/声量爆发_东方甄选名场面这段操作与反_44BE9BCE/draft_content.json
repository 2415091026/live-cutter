        "width": 1080,
        "height": 1920
      }
    ],
    "texts": [
      {
        "id": "4fd3dedc-b12e-4f66-8bb0-51b5509f69aa",
        "content": "{\"text\": \"咱們製作的時候都要經歷兩萬五千次溫折\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "365e0efc-4708-447d-916f-be22bc19bceb",
        "content": "{\"text\": \"那然後呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "11924e84-62fb-457d-81a3-5b56d457ffcc",
        "content": "{\"text\": \"還有那個一萬五千次的耐壓\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7ab59fc1-0af4-4931-b0be-7127d7477bd5",
        "content": "{\"text\": \"都沒有問題才行\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "38b6f6bd-db62-480b-b778-abf891b25bb3",
        "content": "{\"text\": \"那然後最後還要再抽檢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "de58bc0f-4613-4234-a10d-5f214f224d24",
        "content": "{\"text\": \"所以您可以看\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6791d5ba-1538-41e3-b5b7-d4b67e7359bc",
        "content": "{\"text\": \"我們給大家再看有更極端的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c49e6fe9-a3e3-46f7-9e15-de316afdd62d",
        "content": "{\"text\": \"你比如說這個電熱絲電熱坦\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a30c646f-e37b-4aae-b3c8-5210274a7c56",
        "content": "{\"text\": \"我現在不小心迫了水上去了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "150f0bcb-6314-4ade-bea8-cc788cd6ee4d",
        "content": "{\"text\": \"或者說我把它\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1b530dac-2c79-4087-928e-99000c2dd11e",
        "content": "{\"text\": \"這個小航廠了把它進失了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1f7307ca-4639-4c41-8c2e-45c82fb3a6e8",
        "content": "{\"text\": \"來您看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0f600ee9-c9e0-47b2-84ab-e55266b149ee",
        "content": "{\"text\": \"咱們現在這個\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d2b5cfc5-a67c-4584-8196-14454709b921",
        "content": "{\"text\": \"開著是高定時\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a768a58d-89e6-4112-bdd1-b313091f1404",
        "content": "{\"text\": \"我給大家可以再定一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cd2c45aa-fe7f-4bc6-a252-0ebd06c98c66",
        "content": "{\"text\": \"定成12小時\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2f6b28d3-1e9e-4e60-ab02-b93a3f42f4eb",
        "content": "{\"text\": \"定了8小時的朋友們\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1c64ffcc-e6c8-4b8c-ba55-ba154f21ad67",
        "content": "{\"text\": \"給它定了8小時的朋友們\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "111e3eae-7987-4943-aeda-5b79392e780c",
        "content": "{\"text\": \"這個現在就是熱戶戶了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0a7793b2-d7cc-4058-bc18-28b461ec2ab1",
        "content": "{\"text\": \"現在把它泡到水裡\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "96d868cd-fcd3-41e2-88b5-78613d067948",
        "content": "{\"text\": \"你可以看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "82c27a6c-0bd0-492d-9c6c-2b1c46b72373",
        "content": "{\"text\": \"我的手在這個放著電熱坦\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b34c5279-bcf3-48a8-8de2-10e8d85d8fd7",
        "content": "{\"text\": \"工作當中的印轉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ef62e250-d3cc-471c-8d6b-cfd61b68e5db",
        "content": "{\"text\": \"當中的電熱坦那邊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "444a227b-1d32-41c0-9d18-4fdea1f28867",
        "content": "{\"text\": \"我都是沒有問題的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6edaea7a-664f-4a46-b588-8a54c311c2e0",
        "content": "{\"text\": \"把我們可以看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6764c364-2607-4680-93eb-67149eafbda2",
        "content": "{\"text\": \"那我都是很踏實很放心的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "35486424-dd16-4e18-9a3e-098953cc52fe",
        "content": "{\"text\": \"所以這就是咱們的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "31b4fcca-096c-4ab2-87a5-5c318ee55c65",
        "content": "{\"text\": \"國貨大品牌的十億朋友們\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8fbc2cf1-2f0c-4313-a10e-f780653ad4d1",
        "content": "{\"text\": \"來吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "301b73bd-2117-4187-92ca-4c06f0043421",
        "content": "{\"text\": \"跟大家說來價格\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3211acb1-a3d2-404a-bfce-467b7fd352e2",
        "content": "{\"text\": \"馬上給您補貨\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "231fce7b-eb11-4785-a0cd-6a20500670ac",
        "content": "{\"text\": \"但也就那麼一點了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "17955ddf-770f-4cc1-b83a-3a2048899cb9",
        "content": "{\"text\": \"那\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4c723bb0-6472-4682-9236-0eb865c035ca",
        "content": "{\"text\": \"但也就那麼一點了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fd930c14-c286-4bd4-a5d7-8fba48ae3f95",
        "content": "{\"text\": \"來各位看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3929c684-cbf0-419f-933c-4134b6125350",
        "content": "{\"text\": \"日常咱們按著1.5的算\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e7d5196a-b009-47dc-bcd2-9fcb95996436",
        "content": "{\"text\": \"這是特別主流的一個這個尺寸\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "385d20af-21db-40d7-a7e1-5bfdff3b53be",
        "content": "{\"text\": \"1.5的要滿1.8至9\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "136e1e6b-99af-43b3-8168-0104979722b6",
        "content": "{\"text\": \"今天給大家剪2比價格\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1ed08518-0d64-423f-90d0-59f881e35156",
        "content": "{\"text\": \"先剪3.3.30\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1ae1ce06-69c9-4949-90d2-04d2e31123bb",
        "content": "{\"text\": \"所以最後變成相當於6指\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
