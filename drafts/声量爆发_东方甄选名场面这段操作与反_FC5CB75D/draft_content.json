    ],
    "texts": [
      {
        "id": "8b628b95-9c7d-42a7-b7c6-ed2cd5f6efe3",
        "content": "{\"text\": \"可以折敌 但上面别压重物就行\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a23de5c9-cc07-40df-9dd3-fcbdf22f18eb",
        "content": "{\"text\": \"咱们这个1,5,4的那个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "55e356b6-8e23-4ee2-8ab1-ed5a427e45dd",
        "content": "{\"text\": \"就是那个湾折实验\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ca2ab7da-2394-45a8-aae9-bcdb7cd60421",
        "content": "{\"text\": \"那两万多次的一万五千多次的耐压实验\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6dfa3e91-f55c-4a9d-9c8e-fa1653052977",
        "content": "{\"text\": \"然后两万那个5,4的这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4cd9db3f-d262-483f-abd3-acbcafb008ab",
        "content": "{\"text\": \"三折实验\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fff354d6-bbfd-460c-979e-c4fee42bdc1c",
        "content": "{\"text\": \"湾折实验\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4ff7946b-0c43-478c-bca2-cc7db342d0ea",
        "content": "{\"text\": \"都是没有问题的朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6bebc7a2-5dee-4d9a-ab1e-cb81cce4b41a",
        "content": "{\"text\": \"而且是每一个品都要检测\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4c88d947-1764-4f28-a1f8-9d4c1caf408c",
        "content": "{\"text\": \"而不是抽简\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "695d191f-8152-4278-bf71-1d8bb4523186",
        "content": "{\"text\": \"最后有抽简\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6c5eed89-f869-4179-aba8-77f2eaac3eb8",
        "content": "{\"text\": \"但是每一个都要先全剪一遍\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9db8c4aa-976f-4926-bb13-736a890c721c",
        "content": "{\"text\": \"就是我们昨天参观过程工厂是这样的朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5b6f513d-6811-46d9-a2c1-61c814e5c4b3",
        "content": "{\"text\": \"来吧朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4c46329d-93bb-425b-9b2c-374b3e8098a8",
        "content": "{\"text\": \"现在这个冷不冷热不热朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f4ec8f66-f09b-4446-a1eb-7db6cdce39b9",
        "content": "{\"text\": \"咱自己肯定感受到吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "71b561ce-147d-4e1d-bef8-e4f05617dc76",
        "content": "{\"text\": \"今天我们从后台看\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8d857119-a183-4a5d-8c3b-75ebcf86beb7",
        "content": "{\"text\": \"江苏地区买责电视塔的人\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8ed80f88-7d48-4158-9af6-ec73ac02e607",
        "content": "{\"text\": \"特别多\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e9f84fc8-7d2d-4425-9e1d-87cfc310f3a0",
        "content": "{\"text\": \"为什么多呀\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "24770f20-8b63-433f-bdc1-398829bab763",
        "content": "{\"text\": \"我估计肯定是最近的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4e3000a4-9f0f-493a-bbbb-4a793a951a78",
        "content": "{\"text\": \"比较冷吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "33c21d28-04ce-40ff-9439-a9975bb4b7cf",
        "content": "{\"text\": \"所以咱早拍早发货吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6be6d085-3b23-483d-8544-3a3c3b8a00d0",
        "content": "{\"text\": \"真的别等别犹豫\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "078a60af-0c12-4d25-8f3f-d2cb3b9ecf52",
        "content": "{\"text\": \"然后我们这边跟大家说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8de984bb-588e-4c3c-bb8e-b5405d37dc98",
        "content": "{\"text\": \"现在像你家里边\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "86356303-884c-4810-bd6d-cafc891ac5f5",
        "content": "{\"text\": \"比如说您看那个汽小线\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c28e9de2-36c6-4745-8a6b-d26ae0dc20f6",
        "content": "{\"text\": \"你看那个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e82d1d26-b57c-4180-948e-614a14bbf34f",
        "content": "{\"text\": \"什么那个那个所谓的电的那种东西\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d07ffce3-91fe-484f-8dec-5784979ab1ca",
        "content": "{\"text\": \"就是什么那个小太阳\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "587e9f29-681e-4dbe-ad7d-54abbfb367b0",
        "content": "{\"text\": \"我去乎条\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "73aa9bae-46e7-4093-8b8d-ac1ea02f67de",
        "content": "{\"text\": \"解决不了一件事\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2fe9adce-2466-4e46-85e5-645bcd5eb576",
        "content": "{\"text\": \"就是你被握床单的吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5cd53908-b44a-442b-b699-03041b3733d8",
        "content": "{\"text\": \"整头背子\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c1793de4-f776-4239-8dc8-dc5aa663487d",
        "content": "{\"text\": \"如果要是冷凉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f0384a6b-5767-454b-b691-10d18fbcf133",
        "content": "{\"text\": \"好 怎么办\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "07be9723-e5f1-4563-93b8-0d0f795f6af5",
        "content": "{\"text\": \"对吧朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
