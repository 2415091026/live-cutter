    "texts": [
      {
        "id": "dcdf2817-cf82-4412-92bf-3616199b2bac",
        "content": "{\"text\": \"这就一根线了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4577f0cc-0210-41d7-96c4-bcd0a5399e00",
        "content": "{\"text\": \"也比较细\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "afef298b-6581-4c01-8233-436570218abd",
        "content": "{\"text\": \"所以你想这种情况之下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3631077a-eb82-45a7-94ed-05fa5007e805",
        "content": "{\"text\": \"如果真是温度过高了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ab571324-b784-455c-8a5a-fc768e5341fa",
        "content": "{\"text\": \"是不是这个小胶就会被融化掉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0f1fa850-565a-40d0-8ddc-5235ac837017",
        "content": "{\"text\": \"是不是就接受床的被罩\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "da1cafae-ed83-4323-a0df-d90b4061781f",
        "content": "{\"text\": \"就容易找了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8b602811-9896-4dd1-bdb7-44ea26124dbb",
        "content": "{\"text\": \"你想想\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f4cd5432-245e-4b7b-aa5f-45a1961427ee",
        "content": "{\"text\": \"对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "01486c60-0c73-45c9-a784-b925a652dce0",
        "content": "{\"text\": \"那么我跟大家说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "13314ec4-3ff7-4d97-a7a9-c93eb91a375b",
        "content": "{\"text\": \"咱们的这个的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ae957ad6-745a-4e5c-980a-406b72281f79",
        "content": "{\"text\": \"我们的这款到底是怎么给他运行的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dbeef48f-0c85-40ce-bca2-e36bf79641b1",
        "content": "{\"text\": \"你来看\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
