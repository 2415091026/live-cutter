    "texts": [
      {
        "id": "714b45c0-37c5-4449-8c54-a63970590c5f",
        "content": "{\"text\": \"是太凉了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "767bbfff-6284-4fbe-9719-79a6d638bf07",
        "content": "{\"text\": \"我不敢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7b0d2a32-1816-4f8d-ac96-f4cd70c25008",
        "content": "{\"text\": \"就是所谓的光日生的进决\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ee1a3515-ab7b-4fa7-9492-3cdf7e504e91",
        "content": "{\"text\": \"不敢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9a10d794-0aec-40a5-8cca-883c80c3f7c7",
        "content": "{\"text\": \"我穿着睡意\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e34b6323-056b-44a1-a564-b924e84c14ff",
        "content": "{\"text\": \"我才进决\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3fe9adc2-1ae4-45fa-8865-8c4fc6cd9656",
        "content": "{\"text\": \"无论后才敢把睡意\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "552b794a-3c89-4e30-ab93-e105652e861c",
        "content": "{\"text\": \"可能脱掉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e1246f50-fb7a-4f3c-8d9b-1075e1fea2d4",
        "content": "{\"text\": \"那把日融感决\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b28f1101-221e-4643-a2e3-b31965da8480",
        "content": "{\"text\": \"多难受\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a07d737e-4303-4069-b9c4-a441be84e84b",
        "content": "{\"text\": \"所以的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "de756714-bf8b-4b1e-924a-d63a1556a613",
        "content": "{\"text\": \"咱们现在\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "76d62a2e-dfea-4645-a38d-6160bf6c8779",
        "content": "{\"text\": \"为什么要把自己冷得那么的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "927e16b8-356f-407c-abf0-46559572721d",
        "content": "{\"text\": \"这个景破呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dc4958b1-81c2-4057-8cef-935aad3c5721",
