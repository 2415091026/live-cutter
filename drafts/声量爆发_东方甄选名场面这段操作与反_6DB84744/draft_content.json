    "videos": [
      {
        "id": "d3e7c9cd-f26e-4088-aa99-6939151f800b",
        "path": "E:\\代码\\美食街\\live-cutter\\recordings\\20-53-48_东方甄选_p028.mp4",
        "type": "video",
        "duration": 3600000000,
        "width": 1080,
        "height": 1920
      }
    ],
    "texts": [
      {
        "id": "08dee664-dbb2-4d3d-9e9c-f65b1c15d673",
        "content": "{\"text\": \"那这个外表的话呢又加了一层相交\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fd018fce-dd48-43d8-bb67-e29221a0517f",
        "content": "{\"text\": \"看他们这银似的这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e80be735-699d-4902-9a7c-689c497f8e46",
        "content": "{\"text\": \"就从来可以看就跟一个相交管是的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9310a43f-1cbe-41fc-b733-3520f5fbab08",
        "content": "{\"text\": \"这个呢是什么回事呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "66e5c3b0-e8d7-4970-a4c3-3fd3dcdf07f6",
        "content": "{\"text\": \"它呢是70度左右就会容调的这么一种相交\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4c7aea0d-663e-46fc-aeca-b939b4cd0ad9",
        "content": "{\"text\": \"那在它的外表\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2a53c3c9-c6f1-46a2-8e5b-26592c5ec5ae",
        "content": "{\"text\": \"你看这还在传着一根丝呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8d879857-4f1b-4ea5-87c5-6cd0cde36565",
        "content": "{\"text\": \"那这个统丝呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5d4b87d5-91bd-4266-98d0-d12519113615",
        "content": "{\"text\": \"如果要是说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6e4d50e8-ef32-432c-b004-933a3be749d0",
        "content": "{\"text\": \"这个相交遇到70度左右的温度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "71e105e6-bb50-44e7-95c2-9e5bb9bfd5c1",
        "content": "{\"text\": \"它就融化了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d7130c65-b47a-4336-a410-97f29423a9de",
        "content": "{\"text\": \"那么外表这个统丝跟礼拜的发热丝就相遇了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e3f08f45-a778-4522-ba67-d997c9b5c6b5",
        "content": "{\"text\": \"这两一接触它就断电保护\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "12b5f12e-3433-4b59-9236-f17bc8a04372",
        "content": "{\"text\": \"那你想想70度左右的一个温度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ce01f744-d4e7-42d5-93c0-2cef03e28b75",
        "content": "{\"text\": \"是不是距联引发火灾\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b7b5b8c4-e493-4ace-84a4-284a2742cc7e",
        "content": "{\"text\": \"还造着呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cc21df1b-f74f-4575-92a5-ddb7456f7349",
        "content": "{\"text\": \"那么安全细数对吧安心指数\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f786484d-4ff8-439a-a6e0-e2e9613bf7c5",
        "content": "{\"text\": \"真的就大大大的提升了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b24126ad-b236-4886-a3af-08b0903078d3",
        "content": "{\"text\": \"各位能理解这感觉吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e0c2b815-1f1e-479b-8301-5face73d11f4",
        "content": "{\"text\": \"就中间就多了这么一个设计\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7f2689f9-fc19-4e95-aeeb-e4a5be21e308",
        "content": "{\"text\": \"用料可就贵了很大一层了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d31c74cb-7542-4261-b697-0086ef588194",
        "content": "{\"text\": \"因为你人家厂上制作的多呀对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6bb27792-e0e3-427d-93af-4f5b60f5851f",
        "content": "{\"text\": \"所以每一个成本都在不断叠加\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ef1dcd02-e0e1-4bba-8629-0e2378d597fa",
        "content": "{\"text\": \"但是也恰恰因为这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "475de137-36d6-457c-9939-be456e00ecbb",
        "content": "{\"text\": \"所以它才让你用的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "add93613-97d2-4d82-a62a-920205f9c949",
        "content": "{\"text\": \"它是用的安心\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e1dfd897-1e62-4b55-93e1-1eccdb417810",
        "content": "{\"text\": \"就多了这么一层相交外表的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4308121c-3e34-4648-98d3-8ab933090213",
        "content": "{\"text\": \"我以从这个金属丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b85af88d-07a2-4a23-8ac8-c41a1de03053",
        "content": "{\"text\": \"相交70度就融了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "077b159a-c2f9-4036-b6e1-3b86335e6724",
        "content": "{\"text\": \"融了之后这两一碰上就断电\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
    "speeds": [],
    "transitions": []
  },
