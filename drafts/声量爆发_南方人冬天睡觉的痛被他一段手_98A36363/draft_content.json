    "texts": [
      {
        "id": "14c6ec29-cbca-4853-a864-ef3d037de8a5",
        "content": "{\"text\": \"而且的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d065be1c-acf8-4b7f-bad9-b04db5056a00",
        "content": "{\"text\": \"尤其像这个空调可能比较干\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2dc822da-ab23-45be-9fd0-3fa4bc5e5571",
        "content": "{\"text\": \"你还未必适应\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "25334ccb-43fd-4547-aa0f-3551126b12c6",
        "content": "{\"text\": \"像这个小太阳\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8aa40ae1-b272-4c1f-a8fc-7b36e73a6814",
        "content": "{\"text\": \"替了线也只能热一个区域\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ca2ae783-0dec-4cd9-801e-1b87d278a365",
        "content": "{\"text\": \"就不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "328b8a80-a40e-4f62-af09-65b2ad2c86f6",
        "content": "{\"text\": \"咱们比如双上床\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7263aba5-c1de-479d-945b-935162ae1052",
        "content": "{\"text\": \"一般的替了线\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "514ef2db-63fc-42f4-8e57-72d41aca4961",
        "content": "{\"text\": \"你放这边\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f2b7380b-5fa9-48ab-8246-71596d769fa8",
        "content": "{\"text\": \"这边这人怎么办\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5ce9d581-00de-4501-94df-817f037fb8fa",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "48ef3963-5945-4930-b5a0-0d362ea233d7",
        "content": "{\"text\": \"你放脚上你头怎么办\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2d2b772d-fd44-4d09-8469-1d17e3c507ce",
        "content": "{\"text\": \"对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f9fced2c-7978-441e-84f8-58a95e8f70ec",
        "content": "{\"text\": \"而且你备在里边床单上的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0045fac6-8a5f-4b5f-a31c-13c9845ca41d",
        "content": "{\"text\": \"一冷朝食怎么解决\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "73b56dd6-36fb-4863-9820-ebe4c78ceffe",
        "content": "{\"text\": \"各位咱说一个特别现实的问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
