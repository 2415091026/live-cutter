    "texts": [
      {
        "id": "3535876f-814f-4280-b09f-1cfa2bd37435",
        "content": "{\"text\": \"你先拍那些可以刮\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "97f6526a-3853-479e-a087-d5e519d8c007",
        "content": "{\"text\": \"虽然跑步干还没买\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d7013c81-91c0-4295-96fc-5740a2dec949",
        "content": "{\"text\": \"对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "200a995c-cc24-4f56-b3e1-d6ed086fa5fc",
        "content": "{\"text\": \"都不买\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dbb1f488-b0c4-4aff-b1f4-184bd9a0c67f",
        "content": "{\"text\": \"没凯固起呢吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c5ca97ca-5d65-44fe-b9f1-4d000d7868e8",
        "content": "{\"text\": \"你拍这那些可以刮\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4ac4dde5-512e-43a5-bbde-dd6560ba92cf",
        "content": "{\"text\": \"你为了稍以塞\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "67ed2106-a309-456a-86a4-a0c28c1eb563",
        "content": "{\"text\": \"我们这对又开过钱\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f2f42c64-c02c-4142-ad05-fa7eaa28ee7d",
        "content": "{\"text\": \"对啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bff6dc51-a9db-40da-887a-d8bb9a16a45e",
        "content": "{\"text\": \"对哦\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7be4f478-7955-4df6-abc7-d29f7b994900",
        "content": "{\"text\": \"关好草\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7b04e7ba-a565-486e-8d09-aca5ab010d81",
        "content": "{\"text\": \"这关好草\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "23b47424-964f-4117-bc9d-b88b00c12fa2",
        "content": "{\"text\": \"这是来\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a2d871c5-3dd3-49d9-8a4e-f52b1c40e157",
        "content": "{\"text\": \"还小鱼\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "727f72b0-5c48-499c-9f5b-3173b3699ecd",
        "content": "{\"text\": \"我那小鱼一锅了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "28b78fd0-ca07-4532-a197-259457cf7375",
        "content": "{\"text\": \"我开过去\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4396399b-7eb8-4167-bbbf-3e22674a6b67",
        "content": "{\"text\": \"你我那小鱼色无聊要吃呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cf197d7c-b85a-4af7-81c7-f3e1f7a84477",
        "content": "{\"text\": \"跑步干还没跑\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "77f17528-2506-4fb5-8ee5-c4894bc0d2b8",
        "content": "{\"text\": \"他现在没那么甜\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9e3755a6-676f-46ca-915e-29412c6710c6",
        "content": "{\"text\": \"没那么多来吃\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "276de6b1-1ee0-4d49-af06-23fc5a985160",
        "content": "{\"text\": \"炸点\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6f047513-9de2-4fc9-9357-ff30ea543385",
        "content": "{\"text\": \"对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d3735049-6b26-4c43-813b-9a79f527c76b",
        "content": "{\"text\": \"怎么三个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3e341a24-7b5e-4869-b84b-f72556250b96",
        "content": "{\"text\": \"它现在\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9543bf1e-0c70-4402-9b69-d8deb86d1a65",
        "content": "{\"text\": \"跑步干早白\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d7803125-1737-4514-9732-3fa4c7a3f967",
        "content": "{\"text\": \"你们家\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bee7b0f9-ef39-4f07-94ce-2a1fdf42291e",
        "content": "{\"text\": \"我看啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1d950e57-d23e-42e5-a3f6-5a64032f1ced",
        "content": "{\"text\": \"脚对比好脚肝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6850a09d-976f-4074-920a-667add48b2c7",
        "content": "{\"text\": \"小心\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8f2303bf-7346-4c21-85b6-4e66b4abcb79",
        "content": "{\"text\": \"文章\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f166f700-b541-41a8-aee8-043d5a8eb6c6",
        "content": "{\"text\": \"而你而不过一月是一\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b77097c3-b335-4136-91fc-3b5fd73b62a5",
        "content": "{\"text\": \"早来这少子\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ad325b35-3672-43c1-8a48-19528e039929",
        "content": "{\"text\": \"你那什么几年\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3d3f9504-2d37-48a8-8cc1-2fcb15ffd7d2",
        "content": "{\"text\": \"是去称光明了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8d26a7e5-aff3-48bf-b759-bde047d32239",
        "content": "{\"text\": \"你今天又太阳\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ac102211-68d3-4743-8112-407819894471",
        "content": "{\"text\": \"今天又太阳\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c0cafb79-1c74-4666-8ff0-7cd9a4cdd86d",
        "content": "{\"text\": \"应该跑适\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
