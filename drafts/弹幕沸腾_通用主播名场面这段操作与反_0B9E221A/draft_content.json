    "texts": [
      {
        "id": "1471945e-5adb-4125-9ffa-7ef00e7d51a3",
        "content": "{\"text\": \"好吧 我忘了跟这买酷女爷\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e9c43c7f-0fc7-4384-996c-04c217231f38",
        "content": "{\"text\": \"还需要分得快进\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1f8bcd46-e636-4306-9685-7f1bbc71ed7b",
        "content": "{\"text\": \"对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "29c0e38f-35b1-412a-89b0-22d8155692f2",
        "content": "{\"text\": \"所以说我来秘密 也还酷女\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d6876964-fedf-4589-aeb5-3e08ae6bf777",
        "content": "{\"text\": \"要交给\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7470a1ec-1780-4c79-bc0e-94cfbe07afbc",
        "content": "{\"text\": \"能再有想像人买这些亏吃呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1ac19dd6-c98c-4a06-a91b-0c7e9f26b69e",
        "content": "{\"text\": \"对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7f82a499-c64e-4987-bd25-75a476ac0182",
        "content": "{\"text\": \"对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "68324ef4-df4e-4493-aed5-d8a96b8531bb",
        "content": "{\"text\": \"想像人买这些亏吃呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fd056a66-e155-494f-bae5-d1b1052bffcc",
        "content": "{\"text\": \"对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "18af9b58-1106-44f8-8636-ac12782378cb",
        "content": "{\"text\": \"买一国就吃快强\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "eda5508b-d902-4dbc-8d6b-91a89dc1ee56",
        "content": "{\"text\": \"吃快段\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "eb2f68ea-f2fd-45c4-b8d8-47b03e1699ee",
        "content": "{\"text\": \"说这干啥你得去干\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7d58914f-1d40-418d-8adb-c33c8e511509",
        "content": "{\"text\": \"我们记住那些女人干啥\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "44138d94-045a-4794-9b8e-9fa795440bef",
        "content": "{\"text\": \"我们记住那些女人干啥\"}",
        "font_size": 8.0,
