    "texts": [
      {
        "id": "9f66fb1c-f1cb-4148-97d3-5d7639aa61a0",
        "content": "{\"text\": \"开关的位置\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0d6fc158-a0a0-45da-ad55-cf41b6a4606b",
        "content": "{\"text\": \"你通过你自己怎么哭\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d770f1db-0f7d-4ddc-beb7-da862500344d",
        "content": "{\"text\": \"他在这\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9982c72b-3b91-4bb9-ab2d-eaca36e31293",
        "content": "{\"text\": \"在这\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "aca13d30-8c08-457b-93ab-5038deadb51f",
        "content": "{\"text\": \"在这\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e8db9ec9-c62d-408b-af48-49c5312a34cc",
        "content": "{\"text\": \"这四个角\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1cc504d6-338a-4e6b-904c-b8eabb26f022",
        "content": "{\"text\": \"每个地方都行\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c35c9e9c-84b0-4b2a-9328-ced6e5ea4ff4",
        "content": "{\"text\": \"因为这个正反两面\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "928b4175-c18e-407e-af29-21a8dc3077d3",
        "content": "{\"text\": \"他其实是不分的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e1161348-512e-481f-af91-c376ab673270",
        "content": "{\"text\": \"就是你看这面有花瓦\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "41b5e78f-146c-494a-b839-09a3feb917e4",
        "content": "{\"text\": \"感觉像正面\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e763bc22-a205-4f64-804f-c7a6f81afa96",
        "content": "{\"text\": \"但是背面\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b2acdafb-f461-40a2-916e-ed5291e14b0e",
        "content": "{\"text\": \"你哭上\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4650ea52-6808-4da4-8964-c548bdd5c044",
        "content": "{\"text\": \"温度是一样的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "37600894-ad81-4e29-a198-d792f432fecb",
        "content": "{\"text\": \"它没有真正设计所谓的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "547f505f-cc3d-47e8-af86-0f50133c43f1",
        "content": "{\"text\": \"这面是底子\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0e453c5f-e117-4098-9100-fd19784eda07",
        "content": "{\"text\": \"这面是面\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "50e3268e-a467-462e-aa8d-e4420656ec16",
        "content": "{\"text\": \"不是\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e0b75af8-9a54-42c6-9ff1-36ff42a0ca8e",
        "content": "{\"text\": \"两边都可以去用\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "06b54aea-331e-422a-87f9-f36d0a44c8b3",
        "content": "{\"text\": \"阿朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9d8299db-a42a-447e-b8c3-162fa846c27e",
        "content": "{\"text\": \"深色练节\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "97d65c62-ec67-4314-b1d3-d9cd15c4c0ae",
        "content": "{\"text\": \"不是深色练节是个床单\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ea52b3c0-a942-4fc4-a012-64a9ceae2e25",
        "content": "{\"text\": \"阿朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4ab80edd-fe05-4e05-8119-498178f91f12",
        "content": "{\"text\": \"深色是个床单\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3b971ba9-4117-463f-9c6e-2451322fc6ab",
        "content": "{\"text\": \"规交床间可以的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d8ca1e1d-3012-47de-bced-f15c33233182",
        "content": "{\"text\": \"咱们的这个温度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d7be8c20-5a67-479c-a92e-cd6d77a752ef",
        "content": "{\"text\": \"跟他在说一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cbc48e84-bdb2-4374-aecd-508ff5bf539a",
        "content": "{\"text\": \"您现在\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "21e6b64e-e328-405d-a832-ce3706894e60",
        "content": "{\"text\": \"温度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4cdfedf3-a405-4ef9-a213-248c1963e7cc",
        "content": "{\"text\": \"他上百七十度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ee7b968f-f416-4499-85db-6c9b8c2b6c60",
        "content": "{\"text\": \"就里边那个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bf71942d-9c4c-44a2-b01f-202cdf077ea2",
        "content": "{\"text\": \"四十个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4b5e82d3-5c19-4316-bcb2-fc1507ae8910",
        "content": "{\"text\": \"他不给他讲过了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "28517328-72dd-4e0c-be29-47dd4a182f3f",
        "content": "{\"text\": \"这个里边的保护丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2a13b0f3-1b9c-4e9b-a217-ff09d6f76da0",
        "content": "{\"text\": \"七十度就融了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "190a986e-66a9-4cd5-9383-2d9c0a834fdc",
        "content": "{\"text\": \"所以他上线也到不了这么高\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f6de9a4e-f0c3-4690-b614-21676f3d163a",
        "content": "{\"text\": \"正常到不了这么高\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "da44d1e4-fea6-4d42-a4b3-b5ea6700defe",
        "content": "{\"text\": \"你也得盖很厚的东西\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "492c254a-075e-4048-9d90-dc5d45ea4fb7",
        "content": "{\"text\": \"给他展成温度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "58dbdca2-0c20-47ea-b193-d963e6aa2e98",
        "content": "{\"text\": \"才有可能会引杀这种断电\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ca8ad76e-beda-4205-9d66-5e6a6ae05120",
        "content": "{\"text\": \"然后\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b18399c2-42b0-44bf-9b81-0ee04c80331e",
        "content": "{\"text\": \"他这个里边的温度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "23f373fe-cd59-400b-81dc-c69c47aa88d6",
        "content": "{\"text\": \"其实对于人来说\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d55a9fda-9afb-4712-a7e8-451fdf26fbdf",
        "content": "{\"text\": \"五十度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3e50fe91-bb6b-429f-8781-9b7bae13084c",
        "content": "{\"text\": \"要真的直接接受你皮膚\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "45b9c5f1-d2f0-4c05-9ee0-4caa3b1663b4",
        "content": "{\"text\": \"你就已经受不了了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3d251837-d985-46ad-8740-c3992d800565",
        "content": "{\"text\": \"对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "aca1ab9b-1c5e-4087-aca4-accb94b3b29e",
        "content": "{\"text\": \"所以咱们这个样子\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "327c6de9-cb91-4be6-8624-1db4c292403f",
        "content": "{\"text\": \"就是他里边的温度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d3a66743-b5ab-4514-915f-39a073b99d8d",
        "content": "{\"text\": \"也就五六十度\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ccc4f2f3-5c3b-4a5b-868e-a48a86626526",
        "content": "{\"text\": \"但是隔着这一层一层\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "caa3c145-4d31-4388-9856-d168ae4aee12",
        "content": "{\"text\": \"想要最后反应到您身上\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "466bf2c5-e08d-4dd0-8207-32299ab87d65",
        "content": "{\"text\": \"咱们能接触\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
