      }
    ],
    "texts": [
      {
        "id": "8e587a5e-79a4-4a26-a9a2-dfc42d2cf4cc",
        "content": "{\"text\": \"太高了 那我就按着左就想按\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dedb13c7-0769-4bc3-9f78-7a246e15c267",
        "content": "{\"text\": \"哎 往下一按 变成中了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "482274da-8218-4b78-944f-d5a6215bdb2a",
        "content": "{\"text\": \"再按 你看变成低了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "162988e5-ecf2-4e88-941e-51ab235d0c0a",
        "content": "{\"text\": \"再按就关了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d0766b3b-0e0e-493e-9eef-cf37ea7f900a",
        "content": "{\"text\": \"然后再按右边成高了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3538586a-32e5-43cd-b58b-5a7ca5cea150",
        "content": "{\"text\": \"那按吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f60d5287-b105-4436-b6fd-a57b1353763c",
        "content": "{\"text\": \"就一个循环见\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "45c56e68-6391-4eab-b614-e7b4dfba2cfa",
        "content": "{\"text\": \"然后呢 再有的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0a244177-c18a-4f12-be56-8cb45993d27f",
        "content": "{\"text\": \"下不有一个定时间\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "fbcc82ad-1c5e-407c-9cac-dac2362f0299",
        "content": "{\"text\": \"默认识12小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "19c7018d-f2f9-4d58-b731-8699ed4642f8",
        "content": "{\"text\": \"你按一下变8小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3cb4c2f6-5eb7-49ba-a6f3-002db641c51b",
        "content": "{\"text\": \"再按一下变4小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5b7464ad-b1d7-4cf7-8d58-9b75ae3c7657",
        "content": "{\"text\": \"再按一下又回12了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c0029bc4-3fd0-4a40-b113-4fd066c11217",
        "content": "{\"text\": \"也就是说上线的时间就是12小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
