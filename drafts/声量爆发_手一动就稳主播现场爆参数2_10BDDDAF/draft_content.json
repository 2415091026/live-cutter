        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c7f0595d-db78-48d5-ba73-a30a84ec60b3",
        "content": "{\"text\": \"我們這款讓大家長時間對戰手玩會更輕鬆\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1e55dd84-8baa-4bb0-b987-0dd64340d8af",
        "content": "{\"text\": \"比方手玩遊戲\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8e5ea409-b60d-48d4-b101-1c36d5dcd433",
        "content": "{\"text\": \"對吧 或者說你高倉獲得去辦公了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7b9efd04-5e6a-4eb3-9f56-4614bb4933ff",
        "content": "{\"text\": \"那我們就可以選了這款\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "73c99955-c94f-4404-8778-0ca857bf7a53",
        "content": "{\"text\": \"它是PW3395的一個旗艦傳感性\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "49fa514f-248e-4f64-96f3-7da2b21ec695",
        "content": "{\"text\": \"至高能夠達到26000DPI\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d261306c-4dfc-4375-b5b1-bf87e6410bcd",
