  "materials": {
    "videos": [
      {
        "id": "0a7a485d-fe96-44a7-aa9f-3233904846c1",
        "path": "E:\\代码\\美食街\\live-cutter\\recordings\\21-02-08_东方甄选_p034.mp4",
        "type": "video",
        "duration": 3600000000,
        "width": 1080,
        "height": 1920
      }
    ],
    "texts": [
      {
        "id": "7393244a-e689-4e22-a0ac-42a5a3a163e1",
        "content": "{\"text\": \"被握裏本能断活吗 对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "770a29f6-a25f-4945-b03a-017267f1280e",
        "content": "{\"text\": \"你的背子能变得干爽吗\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "23026a5b-4532-49e2-8f33-e09fe3d63dc6",
        "content": "{\"text\": \"然后还要咱们想比如开替条线\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ee6fd2c3-9d42-4ec8-8fef-e9fc33abfd93",
        "content": "{\"text\": \"你哥在左边了 你右边人\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d1b63238-26bd-4941-8c77-2895ef927c65",
        "content": "{\"text\": \"你哥就跟他左边人怎么办\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1e926612-78bf-4f21-b386-b3a12bdb392d",
        "content": "{\"text\": \"你哥脚底也俩谁也不断活 对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c4a26526-68f4-4ced-92bc-ed2d7e36016b",
        "content": "{\"text\": \"然后咱们的这个小太阳那种东西也是\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5ce06805-0415-4a97-a848-e764a705ebaf",
        "content": "{\"text\": \"他就只能照一个局部 对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "486553a7-e1fe-4bfb-8dd4-4ed0a10fb6a8",
        "content": "{\"text\": \"床大背照里面是他也解决不了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7078030a-2682-45f4-a9d3-ec15981574c5",
        "content": "{\"text\": \"没毛毛空调更是如此解决不了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9be2901e-71d7-4a99-a40f-213382fa1019",
        "content": "{\"text\": \"还以上我说这几个还都特别好跌 对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f36925e8-dfc3-4707-ad0d-9f92dde74625",
        "content": "{\"text\": \"工率都不会太小\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "df8e1f2c-93d6-4d36-b528-575c4cb37c9b",
        "content": "{\"text\": \"所以朋友们 你想想这个道理\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "dc84f701-73dc-4475-89fc-7831970db3c1",
        "content": "{\"text\": \"在今天这个科技时代\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e2693d85-a5d4-4474-b16b-932e2dd00096",
        "content": "{\"text\": \"是不是还是跌着谈 对吧 更靠谱\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8f587b62-f101-419f-8d25-06ed379b7c42",
        "content": "{\"text\": \"又便宜 又能解决问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b3adfa62-cf96-4511-91c8-2bace41e75a8",
        "content": "{\"text\": \"那么所以朋友们今天咱给大家做的这个品质就来了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a23cbaeb-990a-492c-818b-5c41f7880cd5",
        "content": "{\"text\": \"就是咱们40多年的老品牌\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5c3cc7f8-8085-4d66-b53e-594db2ed0ef6",
        "content": "{\"text\": \"就是我们的这个国货之光\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "83d60588-3084-4d76-9df1-c6658778a04d",
        "content": "{\"text\": \"咱们的这个彩虹 跌着谈\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "21e02908-e085-465a-acec-91427447f54e",
        "content": "{\"text\": \"那么同时他也是一个在行业内\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f5e54116-c991-480e-b714-bced19b4e76d",
        "content": "{\"text\": \"老大哥的这么一个地位\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "85c15c70-d1de-40d1-9d82-93ba21da717d",
        "content": "{\"text\": \"是国标的制定者之一\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "94e0adcb-81ec-4060-89fe-a2a27c52fbfc",
        "content": "{\"text\": \"真的是非常非常大的这么一个品牌\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "de5b88f4-de16-41ec-bb5b-90a7c301c889",
        "content": "{\"text\": \"所以咱买他肯定\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d54c0713-c0f8-4f9d-a0db-239a488caf5e",
        "content": "{\"text\": \"他是很多人之所以一直以前不敢用电扎他\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
