        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ed4d4c0e-21ae-485a-9e3e-dff2e0870391",
        "content": "{\"text\": \"砂瓦门\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a34a452a-fbc7-42a0-aac9-8b833109c2c8",
        "content": "{\"text\": \"这个是在我们的这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "db0ed3e4-c26d-47bf-b945-bf80520d8751",
        "content": "{\"text\": \"砂瓦门嫂握的8号连鞋可以\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8492f9e4-6280-4a13-8a1c-167ec5f12564",
        "content": "{\"text\": \"点进去吃后的话可以去看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d100cb73-2c7a-42a6-a1bf-13086433fa45",
        "content": "{\"text\": \"这个属标的话现在库存已经不多了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f2ab9624-9144-4ad2-ad18-18a9dfcb555c",
        "content": "{\"text\": \"大家想拍个宝宝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1aecd28d-51d1-4077-8db7-69cf9918f0a2",
        "content": "{\"text\": \"我们抓紧时间偏好属库\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d339677e-8d99-4560-afa6-8f24e7c54e91",
        "content": "{\"text\": \"我们家产品是有7天56日以前的砂瓦门\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "97c8f793-849f-4ccc-9bc6-59e22c1af461",
        "content": "{\"text\": \"所以产品的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "49268eec-3009-4b99-99c3-2c9b71c761b1",
        "content": "{\"text\": \"你拿回家之后的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b59c9cab-21cd-42c5-a31b-da0f1c9eba18",
        "content": "{\"text\": \"你也可以去试一试\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d89a58be-0ffe-452d-94b4-de3c77548694",
        "content": "{\"text\": \"又用体验体验码对不对\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
