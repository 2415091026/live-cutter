        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c11eef3a-d120-4a42-9701-256ba3d9ce84",
        "content": "{\"text\": \"谢宝宝\"}",
