    "texts": [
      {
        "id": "932a0215-1f6a-4df6-93fe-400d6f68996b",
        "content": "{\"text\": \"我的产品 中途又出现到比方说退款\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3617818f-0f0e-4c78-96c2-91dd14b2548f",
        "content": "{\"text\": \"退货 超市为金收 据收退回的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "608ad311-f822-4a37-b425-ff2c86dbee55",
        "content": "{\"text\": \"那我们这个就不一发放了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "54419bb4-f560-4f03-bd4b-3fd8d5e60618",
        "content": "{\"text\": \"这就不一发放了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6ad0c26e-47c3-494d-a321-090fced32c43",
        "content": "{\"text\": \"所以说到它一定是在您\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8a4bfc83-a057-4cc6-8a25-a1b1798d1478",
        "content": "{\"text\": \"确认到产品收到货\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "21d38a46-89e8-4604-9588-d825ba5538c3",
        "content": "{\"text\": \"不退不关的情况下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "074c10cd-58f1-4ca1-92a8-d2e40d1ab11d",
        "content": "{\"text\": \"以另外一个快遇的形势\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "74841821-5b0a-452c-8f48-5c36f25275c3",
        "content": "{\"text\": \"给您安排收到的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bf727c9b-c349-4302-a388-ffe9f5ff6827",
        "content": "{\"text\": \"给您安排收到的\"}",
        "font_size": 8.0,
