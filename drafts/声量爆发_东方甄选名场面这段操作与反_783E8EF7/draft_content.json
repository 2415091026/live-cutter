      }
    ],
    "texts": [
      {
        "id": "3e10a50c-0f62-4f3b-92a1-6536c766b9e0",
        "content": "{\"text\": \"有多少代的这个就是领导都来过长朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e86d91bb-05a8-4c34-a7ac-14e011d7b669",
        "content": "{\"text\": \"这就没给你下入\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a332f022-4877-49e9-8ccc-9a1a1ec2bfa3",
        "content": "{\"text\": \"我们不能展示而已\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "df4bd8cd-95af-49fc-bd32-dbb909512dd9",
        "content": "{\"text\": \"那好几代领导都来过长\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b789fc33-29c1-42d1-8c97-9523df2f5ad7",
        "content": "{\"text\": \"而且是领导领导朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7ca748eb-451f-4421-a658-90a6ab3be16d",
        "content": "{\"text\": \"都来过长朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3678a169-4be9-4da0-9af8-9fd60af6906a",
        "content": "{\"text\": \"所以咱这四个多年的大品牌\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3b5fa001-b917-4803-9745-0e2d279fdc59",
        "content": "{\"text\": \"国货之光朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "d9639ad6-3a16-4c31-b354-27fe9f2afb7c",
        "content": "{\"text\": \"你放心牌\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "db1f4768-c765-48ce-b79b-b7cbc2ef3c4e",
        "content": "{\"text\": \"尤其相对于这个云贵串地区\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0660f81d-098b-4d9b-8eb1-bc3e53dd532f",
        "content": "{\"text\": \"云贵串御地区的朋友们\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1d63bbc5-804b-496f-9874-71ba9da25c4e",
        "content": "{\"text\": \"对这应该特别熟悉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "cc7708c7-1839-4f17-adea-d83dde33be94",
        "content": "{\"text\": \"彩虹真是伴随的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8d8fc391-2dd5-48ef-8a80-2a0c1d439534",
        "content": "{\"text\": \"一代有点能成长\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e044044c-f174-406e-89e5-d167c2789086",
        "content": "{\"text\": \"交代价怎么去用的这个\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3204991c-5cab-4f56-b158-abd52a84bf60",
        "content": "{\"text\": \"特别简单\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4291199b-ef1e-4d0f-b238-a109a99fe38a",
        "content": "{\"text\": \"真的是傻瓜是操作\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "90cb34d8-90a8-432b-9f53-e1fd4cde1303",
        "content": "{\"text\": \"上面可以普通解没问题\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2678beda-5275-400b-a7ac-21617825cffe",
        "content": "{\"text\": \"来给各位看一下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0a5e4dc5-1bdb-4648-954b-e83891fd41a7",
        "content": "{\"text\": \"怎么用啊\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a8395f65-fa1a-420a-b80b-7c4fa2f5b3f2",
        "content": "{\"text\": \"开关网上一波\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f87b806d-cb57-446b-80ce-98b5361326fa",
        "content": "{\"text\": \"我现在做的就是一号练接\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7b5b91b2-1727-4d74-812f-3fab7c0966e5",
        "content": "{\"text\": \"但晚上一波就行了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "aaf03779-445b-418d-adfc-aef16ffc1083",
        "content": "{\"text\": \"你看这个左右两边\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "75dafe83-8e53-4066-b1f0-35d52d063ce0",
        "content": "{\"text\": \"因为这双人的码\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8c72f2d4-98ae-4e82-ab15-0aace7b9266e",
        "content": "{\"text\": \"他就可以这个孙区空温\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "3d74f075-51df-414a-bb4f-10ec7293b671",
        "content": "{\"text\": \"你看比如说左边现在是高的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "418f901a-db71-4967-9fbe-b5b8bcc84029",
        "content": "{\"text\": \"我按一下左这边是中了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "85366719-be74-4050-8421-a72a409ec1dd",
        "content": "{\"text\": \"站一下变低了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c45b3d82-b110-4bf5-a62d-c91219dd9e17",
        "content": "{\"text\": \"站一下左边就关了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "32334ec0-e637-42bc-8129-ccb53ee0367c",
        "content": "{\"text\": \"站一下右边就高了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "af05236c-436a-4194-abee-f98ad9fae7c0",
        "content": "{\"text\": \"就是按四下就医循环\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "55ab2f4d-20a2-4a5b-94f8-ee05197e46aa",
        "content": "{\"text\": \"右边也是一样的道理\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "c113d5ca-77b1-4669-a40a-db5265ca0433",
        "content": "{\"text\": \"然后下北一个定时间\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "710ae20a-f020-4ba7-a1d2-ddf582b29b2b",
        "content": "{\"text\": \"按三下医循环\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f3f8df60-d723-4e83-8601-c55f18200da0",
        "content": "{\"text\": \"默认是12小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5d99a9ec-96e5-40a9-a492-f7f11f8b2940",
        "content": "{\"text\": \"按一下变八小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "36f46c23-65e5-4764-afb7-60791185a424",
        "content": "{\"text\": \"站一下四小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2d7ade44-410a-4d40-9aca-b59ed270707e",
        "content": "{\"text\": \"站一下12小时\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "1a6178db-94cb-42c1-8748-864875d94ed8",
        "content": "{\"text\": \"对吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7023db64-560d-471d-8755-576f7a69f1ed",
        "content": "{\"text\": \"就是\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
