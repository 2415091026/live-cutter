    "texts": [
      {
        "id": "b0e1e3fb-7a2a-4829-9a8f-bc8b87ae5fba",
        "content": "{\"text\": \"然后在这层丝的外边\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4e527edd-7bba-4874-a83b-80d860c7d260",
        "content": "{\"text\": \"你看不直接加这层摆的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "83a552b9-6b1f-4f3a-867c-3d375a6b485b",
        "content": "{\"text\": \"这个这个决原丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "8a871b24-e67d-4368-a2b3-39ee266a7187",
        "content": "{\"text\": \"就决原相交而是在先再来一层这个相交\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6d45ce23-c6d3-4cf2-8bd8-00f1a57db516",
        "content": "{\"text\": \"这层相交的话\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "5b755229-bd87-4c9d-b1ec-9460c0d1f27e",
        "content": "{\"text\": \"把它套上之后\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "02258eb0-bab5-4f9d-9420-8408863a4c8b",
        "content": "{\"text\": \"它外边再来这样的一个同丝\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "60372a78-9ddd-45ab-a1f1-8e2ed7c017f3",
        "content": "{\"text\": \"能看着来吧\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "7ea151cb-ce94-4749-846e-8e8ae4ba4ab3",
        "content": "{\"text\": \"等于这就已经四样东西了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "4d0dc9e9-65f3-40ba-b78a-e82c251cc52a",
        "content": "{\"text\": \"那怎么个原理呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a5c32a69-88de-42be-8638-eb5f9187b721",
        "content": "{\"text\": \"这个发热丝如果达到七十度左右\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b6644d6a-b2c2-4ca8-8f9c-3f5d46962285",
        "content": "{\"text\": \"就过载了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "36bebc7f-5153-4bc2-b635-8e3adb15c673",
        "content": "{\"text\": \"就过分了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "923bc7d9-6c86-41c9-bdf4-a5f003a428b9",
        "content": "{\"text\": \"那它的这个相交呢\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "ebeb3339-3626-4904-a130-5afec1c6afc2",
        "content": "{\"text\": \"这层相交多加的相交\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
