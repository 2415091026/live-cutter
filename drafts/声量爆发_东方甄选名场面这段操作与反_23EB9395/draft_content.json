  "materials": {
    "videos": [
      {
        "id": "92e5c346-850f-48fa-b670-88412b8be678",
        "path": "E:\\代码\\美食街\\live-cutter\\recordings\\20-52-26_东方甄选_p027.mp4",
        "type": "video",
        "duration": 3600000000,
        "width": 1080,
        "height": 1920
      }
    ],
    "texts": [
      {
        "id": "81987dd3-1fd4-453d-acaa-12b1d8104052",
        "content": "{\"text\": \"廣西今年的北京都還在出現電熱彈\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "85fd5819-f16f-44d0-a214-fe31c52f4d0f",
        "content": "{\"text\": \"出事的問題以及直接把臥勢考招了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e31b3da5-616f-4dbb-bfcb-1b7cc865e592",
        "content": "{\"text\": \"臥勢收招了朋友們多嚇人\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "20214dec-f64c-4025-b197-54b8db2fe25b",
        "content": "{\"text\": \"開酒店也是有些那種咖民素\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bded6c27-4e3b-4e67-8412-fcd661d3b317",
        "content": "{\"text\": \"在山區是不是對吧很冷\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "589ac260-e5f9-4337-9be2-249559342682",
        "content": "{\"text\": \"又是靠著江邊湖邊海邊的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f9fe693c-f699-42f1-a702-7526ead787e9",
        "content": "{\"text\": \"以及給你的床考個大酷露\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a169b97f-28e5-4be6-a589-66c0fef4145e",
        "content": "{\"text\": \"真的挺嚇人的\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "357d0ae8-74e7-48eb-9d0d-f6a41fb0c9ed",
        "content": "{\"text\": \"打扮你鋪面了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "da2e0d36-e4b5-4387-989b-25e155d3b26d",
        "content": "{\"text\": \"你肯定也後怕\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "a0b31a4f-5cea-4cb6-b08b-f639020fa043",
        "content": "{\"text\": \"這東西可能你再也不敢用了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f1b566f1-40bf-463e-ade5-b36c0b39f1e2",
        "content": "{\"text\": \"但我跟大家說\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "2a2c96e0-ecad-4d62-9a5c-3c61df035677",
        "content": "{\"text\": \"這個電熱彈到底怎麼知道\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "6159d069-a63d-4217-8645-a212a522e6f3",
        "content": "{\"text\": \"叫好為什麼那些會出現火情\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "bcdf56f9-fe90-47a9-b256-bbf81a5bfe4f",
        "content": "{\"text\": \"給大家把原理講明白\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0ec68732-49d9-485c-967a-0e12d0fdbe72",
        "content": "{\"text\": \"來看看傳統的電熱彈是怎麼個原理\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "99c47f1e-5543-4722-91d2-fae1e0981407",
        "content": "{\"text\": \"中間不就靠這個發熱絲\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "e8cb9b86-61b4-4a32-868b-c93ba805de95",
        "content": "{\"text\": \"你看它中間是這樣的一個\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "9341529c-4229-4124-a9b4-34ddce797b55",
        "content": "{\"text\": \"一股神在這股神的外表\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "10ee0967-af0d-4a2c-8144-8033aaee0f36",
        "content": "{\"text\": \"這樣螺旋狀的混燃發熱絲\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "f7ad39b6-af01-4527-9eee-c686f657587b",
        "content": "{\"text\": \"然後在外表在加這個香蕉絕援的結人香蕉\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "aa2bbde2-41ca-4465-92f5-5cf1eb5d1498",
        "content": "{\"text\": \"就是一個設計\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "0c8aebd8-5841-4af8-bb95-e8c2974ae615",
        "content": "{\"text\": \"這種情況之下\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "92dcd376-a79e-4c6d-9eef-d215b4d9ba03",
        "content": "{\"text\": \"朋友們您可以看\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "b8dd37cb-fe57-4bf6-a5cd-4e44c9163577",
        "content": "{\"text\": \"如果這個發熱絲\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "58276047-f420-4011-bc82-4310ae76bf09",
        "content": "{\"text\": \"它要是過於熱了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "46c0c1c9-e1db-416b-992f-9c0bbffc275f",
        "content": "{\"text\": \"是不是就容易把這個香蕉給考慮了\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      },
      {
        "id": "36b5574b-f313-4a7d-ab5a-20c9d15911a0",
        "content": "{\"text\": \"考畫熱打扮就考畫了一點點\"}",
        "font_size": 8.0,
        "text_color": "#FFD700",
        "border_color": "#000000",
        "border_width": 2.0,
        "type": "subtitle"
      }
    ],
    "speeds": [],
    "transitions": []
  },
